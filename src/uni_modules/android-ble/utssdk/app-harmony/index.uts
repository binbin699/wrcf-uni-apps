	 public  writeStringDataToBle(service:string,chars:string,data:string,callback:(sth:MyApiResult) => void){
		 var sendCharacteristics=	this.scanCharacteristics.get(chars)!;
		 
			var buffer=this.hexStringWithSpacesToArrayBuffer(data);
			if(this.haveSetMtu){
				sendCharacteristics.characteristicValue=buffer;
				try{
								var type=ble.GattWriteType.WRITE
								if(sendCharacteristics.properties?.write){
									type=ble.GattWriteType.WRITE
								}else{
									type=ble.GattWriteType.WRITE_NO_RESPONSE
								}
							this.  gattClient?.writeCharacteristicValue(sendCharacteristics, type, (err) => {
				    if (err) {
				      // console.error( 'errCode: ' + (err as BusinessError).code + ', errMessage: ' + (err as BusinessError).message);
							   callback(bleResult(10001,"",""));
				      return;
				    }
				    // console.info( 'writeCharacteristicValue success');
							 callback(bleResult(0,"",""));
				  });
				} catch (err) {
				    console.error('errCode: ' + (err as BusinessError).code + ', errMessage: ' + (err as BusinessError).message);
				}
			}else{
				var d:ArrayBuffer[]=	this.splitArrayBuffer(buffer)
				for(var i=0;i<d.length;i++){
					sendCharacteristics.characteristicValue=d[i];
					try{
									var type=ble.GattWriteType.WRITE
									if(sendCharacteristics.properties?.write){
										type=ble.GattWriteType.WRITE
									}else{
										type=ble.GattWriteType.WRITE_NO_RESPONSE
									}
								this.  gattClient?.writeCharacteristicValue(sendCharacteristics, type, (err) => {
					    if (err) {
					      // console.error( 'errCode: ' + (err as BusinessError).code + ', errMessage: ' + (err as BusinessError).message);
								   callback(bleResult(10001,"",""));
					      return;
					    }
					    // console.info( 'writeCharacteristicValue success');
								 callback(bleResult(0,"",""));
					  });
					} catch (err) {
					    console.error('errCode: ' + (err as BusinessError).code + ', errMessage: ' + (err as BusinessError).message);
					}
				}
				
				
			}
			
			
			
			
	 			
	 }
	 
	 public async sendData(data:WriteData,callback:(b:MyApiResult)=>void){
		 var sendCharacteristics:ble.BLECharacteristic =	this.scanCharacteristics.get(data.characteristicId)!;
		var buffer:  ArrayBuffer|null=null;
		 if(data.data!=null){
			buffer=	this.hexStringWithSpacesToArrayBuffer(this.byte2HexString(data.data!))
		 }
		 
		 if(data.hexStrData!=null){
			  buffer=this.hexStringWithSpacesToArrayBuffer(data.hexStrData!);
		 }
		 if(!data.fenbao){
				sendCharacteristics.characteristicValue=buffer!;
		 	try{			
							if(data.writeType==null){
								var type=ble.GattWriteType.WRITE
									if(sendCharacteristics.properties?.write){
										type=ble.GattWriteType.WRITE
									}else{
										type=ble.GattWriteType.WRITE_NO_RESPONSE
									}
									this.  gattClient?.writeCharacteristicValue(sendCharacteristics, type, (err) => {
									if (err) {
									   callback(bleResult(10001,"",""));
									return;
									}
								
										callback(bleResult(0,"",""));
									});
							}else{
								var type=ble.GattWriteType.WRITE
									if(data.writeType==0){
										type=ble.GattWriteType.WRITE
									}else{
										type=ble.GattWriteType.WRITE_NO_RESPONSE
									}
								this.  gattClient?.writeCharacteristicValue(sendCharacteristics, type, (err) => {
																	if (err) {
																	   callback(bleResult(10001,"",""));
																	return;
																	}
																
																		callback!(bleResult(0,"",""));
																	});
							}
		 					
		 	} catch (err) {
		 	    console.error('errCode: ' + (err as BusinessError).code + ', errMessage: ' + (err as BusinessError).message);
		 	}
		 }else{
		 	var d:ArrayBuffer[]=	this.splitArrayBuffer(buffer!)
			var haveErr=false;
		 	for(var i=0;i<d.length;i++){
		 		sendCharacteristics.characteristicValue=d[i];
		 		try{
		 						var type=ble.GattWriteType.WRITE
								if(data.writeType==null){
									if(sendCharacteristics.properties?.write){
										type=ble.GattWriteType.WRITE
									}else{
										type=ble.GattWriteType.WRITE_NO_RESPONSE
									}
								}else{
									if(data.writeType==0){
										type=ble.GattWriteType.WRITE
									}else{
										type=ble.GattWriteType.WRITE_NO_RESPONSE
									}
								}
								
							await	this.writeData(sendCharacteristics,type,(b:boolean)=>{
								if(!b){
									haveErr=true;
								}
								
							})
		 		} catch (err) {
		 		    console.error('errCode: ' + (err as BusinessError).code + ', errMessage: ' + (err as BusinessError).message);
		 		}
		 	}
			if(haveErr){
				callback(bleResult(10001,"",""));
				
			}else{
				callback(bleResult(0,"",""));
			}
		 	
		 	
		 }
		 
	 }
	 
	 async writeData(sendCharacteristics:ble.BLECharacteristic ,type:ble.GattWriteType,callback:(b:boolean)=>void){
		return	new Promise<void>((resolve, reject) => {
			this.  gattClient?.writeCharacteristicValue(sendCharacteristics, type, (err) => {
													if (err) {
			    console.error( 'errCode: ' + (err as BusinessError).code + ', errMessage: ' + (err as BusinessError).message);
					 					  callback(false);
											resolve();
											return
			  }
			  console.info( 'writeCharacteristicValue success');
					 					 callback(true);
										 resolve();
			});					
		 })
		 
	 }
	 
	  // 8. 定义特征值变化回调函数
	   // onCharacteristicChange  (char: ble.BLECharacteristic)  {
		  //  this.notityCharacteristicsCallback(bleResult(0,"",this.arrayBufferToHexStringWithSpaces(char.characteristicValue)));
