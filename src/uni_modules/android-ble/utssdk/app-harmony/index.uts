	 public onNotityReadBleData(service:string,chars:string,state:boolean,callback:(sth:MyApiResult) => void){
		 // this.gattClient.
		try {
		      if(this.characteristicChangeFunction!=null){
		      	try{
		      		this.gattClient?.off('BLECharacteristicChange', this.characteristicChangeFunction!);
		      	}catch(err){
		      		console.log(err);
		      	}
		      	this.characteristicChangeFunction=null;
		      }
			   let descriptors: Array<ble.BLEDescriptor> = [];
			   let arrayBuffer = new ArrayBuffer(2);
			   let descV = new Uint8Array(arrayBuffer);
			   // CCCD: 0x0001=Notification, 0x0002=Indication, 0x0000=关闭
			   descV[0] = state ? 1 : 0;
			   descV[1] = 0;
			   let descriptor: ble.BLEDescriptor = {
				   serviceUuid:service,
			      characteristicUuid: chars,
			      descriptorUuid: '00002902-0000-1000-8000-00805F9B34FB', descriptorValue: arrayBuffer};
				  descriptors[0] = descriptor;
			   let arrayBufferC = new ArrayBuffer(8);
			   let characteristic: ble.BLECharacteristic = {serviceUuid: service,
			     characteristicUuid: chars, characteristicValue: arrayBufferC, descriptors:descriptors};
			   if(state){
			   	  // 订阅特征值变化
			   	this.characteristicChangeFunction=(char: ble.BLECharacteristic)=>  {
			   		   callback(bleResult(0,"data ",this.arrayBufferToHexNumber(char.characteristicValue)));
			   	   };
			   	this.gattClient?.on('BLECharacteristicChange',this.characteristicChangeFunction!);
			   }
			   
		      // 设置特征值变化通知能力，enable: true表示启用，false表示禁用
		      this.gattClient?.setCharacteristicChangeNotification(characteristic, state,(err: BusinessError) => {
				if (err) {
					// console.error('notifyCharacteristicChanged callback failed');
					callback(bleResult(1001,"订阅失败",[] as number[]));
				} else {
					// console.info('notifyCharacteristicChanged callback successful');
					callback(bleResult(1000,"订阅成功",[] as number[]));
					
				}
			});
		    } catch (err) {
		      console.error('errCode: ' + (err as BusinessError).code + ', errMessage: ' + (err as BusinessError).message);
		    }
			
			this.notityCharacteristicsCallback=callback;
	 }
	 
	 public onNotityBleData(service:string,chars:string,state:boolean,callback:(sth:MyApiResult) => void){
	 		 // this.gattClient.
	 		var that=this;
			try {
		      if(this.characteristicChangeFunction!=null){
		      	try{
		      		this.gattClient?.off('BLECharacteristicChange', this.characteristicChangeFunction!);
		      	}catch(err){
		      		console.log(err);
		      	}
		      	this.characteristicChangeFunction=null;
		      }
	 			   let descriptors: Array<ble.BLEDescriptor> = [];
	 			   let arrayBuffer = new ArrayBuffer(2);
	 			   let descV = new Uint8Array(arrayBuffer);
	 			   descV[0] = state ? 1 : 0;
	 			   descV[1] = 0;
	 			   let descriptor: ble.BLEDescriptor = {
	 				   serviceUuid:service,
	 			      characteristicUuid: chars,
	 			      descriptorUuid: '00002902-0000-1000-8000-00805F9B34FB', descriptorValue: arrayBuffer};
	 				  descriptors[0] = descriptor;
	 			   let arrayBufferC = new ArrayBuffer(8);
	 			   let characteristic: ble.BLECharacteristic = {serviceUuid: service,
	 			     characteristicUuid: chars, characteristicValue: arrayBufferC, descriptors:descriptors};
	 			   if(state){
	 			   	  // 订阅特征值变化
	 			   	this.characteristicChangeFunction=(char: ble.BLECharacteristic)=>  {
	 			   		   callback(bleResult(0,"data ",{
	 						   data:this.arrayBufferToHexNumber(char.characteristicValue),
	 						   serviceId:char.serviceUuid,
	 						   characteristicsId:char.characteristicUuid,
	 							mac: that.getConnectMac(),
	 						   
	 					   } as NotityData));
	 			   	   };
	 			   	this.gattClient?.on('BLECharacteristicChange',this.characteristicChangeFunction!);
	 			   }
	 			   
	 		      // 设置特征值变化通知能力，enable: true表示启用，false表示禁用
	 		      this.gattClient?.setCharacteristicChangeNotification(characteristic, state,(err: BusinessError) => {
	 				if (err) {
	 					// console.error('notifyCharacteristicChanged callback failed');
	 					callback(bleResult(1001,"订阅失败",[] as number[]));
	 				} else {
	 					// console.info('notifyCharacteristicChanged callback successful');
	 					callback(bleResult(1000,"订阅成功",[] as number[]));
	 					
	 				}
	 			});
	 		    } catch (err) {
	 		      console.error('errCode: ' + (err as BusinessError).code + ', errMessage: ' + (err as BusinessError).message);
	 		    }
	 			
	 			this.notityCharacteristicsCallback=callback;
	 }
	 
	 
		 
	 public close():void {
		  try {
			  this.cancelAutoConnectBt();
			  this.disposePassive();
			  // console.log("close")
			  clearTimeout(this.connect_timeoutId);
		      this.gattClient?.disconnect(); // 11.1 断开连接
		      this.gattClient?.close() // 11.4 如果应用不再使用此gattClient，则需要close
			this.gattClient=null;
			this.connectState=false;
			this.connectMac=null;
			this.beginToConnectMac=null;
			} catch (err) {
		      console.error( 'errCode: ' + (err as BusinessError).code + ', errMessage: ' + (err as BusinessError).message);
		    }
		 
	 }
	 
	public setMtu(num:number,callback:(sth:MyApiResult) => void):void{
		var that=this;
		if(this.isConnected()){
			
			try {
			    this.gattClient?.setBLEMtuSize(num);
			     this.gattClient?.on('BLEMtuChange', (mtu: number) => {
			          console.info('BLEMtuChange, mtu: ' + mtu);
			    	  callback(bleResult(0,"",mtu))
					  that.haveSetMtu=true;
			    });
			} catch (err) {
				callback(bleResult(1,"",0))
			    console.error('errCode: ' + (err as BusinessError).code + ', errMessage: ' + (err as BusinessError).message);
			}
			
		
		}
		 
		 
	 }
	 
	  stringToHexUTF8WithSpaces(input: string,en:string): string {
	     // 将字符串编码为UTF-8
	     const textEncoder = util.TextEncoder.create(en);;
		var utf8Array= textEncoder.encodeInto(input)
	     // 将每个字节转换为两位的十六进制表示，并添加空格
	     let hexString = '';
	     for (let i = 0; i < utf8Array.length; i++) {
	         hexString += utf8Array[i].toString(16).padStart(2, '0') + '';
	     }
	     // 去除最后一个多余的空格
	     return hexString.trim().toUpperCase();
	 }
	 
	 
