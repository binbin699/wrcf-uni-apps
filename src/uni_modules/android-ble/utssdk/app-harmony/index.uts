	 public string2ByteStrWithCharset(data:string,code:string):string{
		 return this.stringToHexUTF8WithSpaces(data,code);
	 }
	 
	 
	  hexStringWithSpacesToText(hexString: string,en:string): string {
	     // 去除可能存在的空格
	     hexString = hexString.replace(/\s/g, '');
	     // 检查字符串长度是否为偶数
	     if (hexString.length % 2 !== 0) {
	         throw new Error('Invalid hex string');
	     }
	     // 创建一个Uint8Array来存储字节
	     const buffers = new Uint8Array(hexString.length / 2);
	     for (let i = 0; i < hexString.length; i += 2) {
	         buffers[i / 2] = parseInt(hexString.substring(i, i + 2), 16);
	     }
	     // 使用TextDecoder将字节数组解码为文本
	       let decoder = util.TextDecoder.create(en);
	       let stringData = decoder.decodeToString(buffers);
	     return stringData;
	 }
	 public byte2StringWithCharset(data:string,code:string):string{
		return this.hexStringWithSpacesToText(data,code).replace(/\s/g, '');
	 }
	 
	 
	 
	  hexStringWithSpacesToArrayBuffer(hexString: string): ArrayBuffer {
	     // 去除可能存在的空格
	     hexString = hexString.replace(/\s/g, '');
	     // 检查字符串长度是否为偶数
	     if (hexString.length % 2 !== 0) {
	         throw new Error('Invalid hex string');
	     }
	     // 创建一个Uint8Array来存储字节
	     const buffer = new Uint8Array(hexString.length / 2);
	     for (let i = 0; i < hexString.length; i += 2) {
	         buffer[i / 2] = parseInt(hexString.substring(i, i + 2), 16);
	     }
	     return buffer.buffer;
	 }
	 
	 
	 /**
	  * 将 ArrayBuffer 按指定大小分包
	  * @param {ArrayBuffer} arrayBuffer - 要分割的 ArrayBuffer
	  * @param {number} chunkSize - 每包大小，默认 20 字节
	  * @returns {ArrayBuffer[]} 分包后的 ArrayBuffer 数组
	  */
	  splitArrayBuffer(arrayBuffer:ArrayBuffer, chunkSize:number = 20) {
	     const totalLength = arrayBuffer.byteLength
	     const result:ArrayBuffer[] = [] as ArrayBuffer[]
	     
	     for (let offset = 0; offset < totalLength; offset += chunkSize) {
	         const end = Math.min(offset + chunkSize, totalLength)
	         const chunkLength = end - offset
	         
	         // 创建新的 ArrayBuffer
	         const chunkBuffer = new ArrayBuffer(chunkLength)
	         const sourceView = new DataView(arrayBuffer)
	         const targetView = new DataView(chunkBuffer)
	         
	         // 复制数据
	         for (let i = 0; i < chunkLength; i++) {
	             const value = sourceView.getUint8(offset + i)
	             targetView.setUint8(i, value)
	         }
	         
	         result.push(chunkBuffer)
	     }
	     
	     return result
	 }
	 
	
	 
	  arrayBufferToHexNumber(buffer: ArrayBuffer): number[] {
		  var b:number[]=[] as number[]
		  const uint8Array = new Uint8Array(buffer);
		  for (let i = 0; i < uint8Array.length; i++) {
		      // 将每个字节转换为两位的十六进制表示，并添加空格
		      b.push(uint8Array[i]);
		  }
		  
		  return b;
	  }
	 
	 
	 arrayBufferToHexStringWithSpaces(buffer: ArrayBuffer): string{
	     const uint8Array = new Uint8Array(buffer);
		 
	     let hexString = '';
	     for (let i = 0; i < uint8Array.length; i++) {
	         // 将每个字节转换为两位的十六进制表示，并添加空格
	         hexString += uint8Array[i].toString(16).padStart(2, '0') + ' ';
	     }
	     // 去除最后一个多余的空格
	     return hexString.trim();
	 }
	 
	 
	 
	 public getUUIDs():WNuuid[]{
	 	var ids=[] as WNuuid[];
	 	for(var i=0;i<this.wNList.length;i++){
	 		var b=this.wNList[i].split("_");
	 		ids.push({
	 			serviceId:b[0],
	 			nuuid:b[1],
	 			wuuid:b[2]
	 		} as WNuuid)
	 	}
	 	return ids;
	 }
	 
	 public setSelectUUID(id:number){
	 	if(id<this.wNList.length){
	 		var b=this.wNList[id].split("_");
	 		this.tarServiceUUID=b[0];
	 		this.nUUID=b[1];
	 		this.wUUID=b[2];
			
	 	}
	 		
	 }
	 
