	 reqBtPer(callback:(b:boolean)=>void){
		 const permissions :Array<Permissions>= [
		   'ohos.permission.USE_BLUETOOTH',
		   'ohos.permission.ACCESS_BLUETOOTH',
		   'ohos.permission.DISCOVER_BLUETOOTH',
		   'ohos.permission.MANAGE_BLUETOOTH',
		   'ohos.permission.LOCATION'
		 ];
		 let permissionName: Permissions = 'ohos.permission.ACCESS_BLUETOOTH';
		 let tokenID: number = 10; 
		let atManager: abilityAccessCtrl.AtManager = abilityAccessCtrl.createAtManager();
		 var have=	atManager.checkAccessTokenSync(tokenID,permissionName);
		 if(have == abilityAccessCtrl.GrantStatus.PERMISSION_DENIED){
			 const permissions: Array<Permissions> = ['ohos.permission.ACCESS_BLUETOOTH'];
			 atManager.requestPermissionsFromUser(UTSHarmony.getUIAbilityContext(), permissions).then((data) => {
			   let grantStatus: Array<number> = data.authResults;
			   let length: number = grantStatus.length;
			   // console.log(grantStatus);
			   if(grantStatus.length==1){
			 		   if(grantStatus[0]==0){
			 			   callback(true);
			 		   }else{
			 			   callback(false);
			 		   }
			   }
			 }).catch((err: BusinessError) => {
			   // console.error(`Failed to request permissions from user. Code is ${err.code}, message is ${err.message}`);
			 		callback(false);
			 })
			 
		 }else{
			 callback(true);
		 }
		
	}
	
	
	
	
	
	
	public onBtOpenStateListener(callback: (sth:MyApiResult) => void ){
		this.btOpenStateCallback=callback;
		this.ensureBtStateListener();
		callback(bleResult(0,"",this.isEnabled()))
	}
	open_timer_id:number=-1;
	constructor(){
		try {
			this.createBtStateListener();
		} catch (err) {
			console.error('errCode: ' + (err as BusinessError).code + ', errMessage: ' + (err as BusinessError).message);
		}
	}

	createBtStateListener(){
		if(this.btStateChangeFunction!=null){
			return;
		}
		var that=this;
		this.btStateChangeFunction=(data: access.BluetoothState) => {
			clearTimeout(that.open_timer_id);
			that.open_timer_id= setTimeout(function(){
				if(data==0){
					hmscanMap.clear();
					that.btOpenStateCallback(bleResult(0,"蓝牙关闭",false))
				}else if(data==2){
					that.btOpenStateCallback(bleResult(0,"蓝牙开启",true))
				}
			},1000)
			
		};
	}

	ensureBtStateListener(){
		this.createBtStateListener();
		if(this.btStateListenerRegistered){
			return;
		}
		access.on('stateChange', this.btStateChangeFunction!);
		this.btStateListenerRegistered=true;
	}
	
	public btListener(){
		
	
	}

	public disposePassive():void{
		try {
			if(this.connectInternal!=0){
				clearInterval(this.connectInternal);
				this.connectInternal=0;
			}
			clearTimeout(this.connect_timeoutId);
			clearTimeout(this.scanTimeout);
			clearTimeout(this.open_timer_id);
			if(this.scanBleFunction!=null){
				ble.off("BLEDeviceFind",this.scanBleFunction!);
				this.scanBleFunction=null;
			}
			if(this.connectStateFunction!=null){
				try{
					this.gattClient?.off('BLEConnectionStateChange',this.connectStateFunction!);
				}catch(err){
					console.log(err);
				}
				this.connectStateFunction=null;
			}
			if(this.characteristicChangeFunction!=null){
				try{
					this.gattClient?.off('BLECharacteristicChange', this.characteristicChangeFunction!);
				}catch(err){
					console.log(err);
				}
				this.characteristicChangeFunction=null;
			}
			if(this.btStateChangeFunction!=null && this.btStateListenerRegistered){
				try{
					access.off('stateChange', this.btStateChangeFunction!);
				}catch(err){
					console.log(err);
				}
				this.btStateListenerRegistered=false;
			}
			this.btStateChangeFunction=null;
		} catch (err) {
			console.error('errCode: ' + (err as BusinessError).code + ', errMessage: ' + (err as BusinessError).message);
		}
	}
	
	
	openBtBluetooth(callback:(b:MyApiResult)=>void){
		try {
		  bluetooth.enableBluetooth();
		  callback(bleResult(0,"",""))
		  return true;
		} catch (err) {
			callback(bleResult(-1,"",""))
		  console.error(`enableBluetooth error: ${JSON.stringify(err)}`);
		  return false;
		}
	}
	
	
	readRssi(callback:(b:MyApiResult)=>void){
		try {
			console.log("readRssi")
		   this. gattClient?.getRssiValue().then((data: number) => {
		           callback(bleResult(0,"",data))
		       })
		} catch (err) {
		    console.error('errCode: ' + (err as BusinessError).code + ', errMessage: ' + (err as BusinessError).message);
		}
		
	}
	
	openBluetooth(on:boolean):void{
		try {
		  bluetooth.enableBluetooth();
		} catch (err) {
		  console.error(`enableBluetooth error: ${JSON.stringify(err)}`);
		}
	}
