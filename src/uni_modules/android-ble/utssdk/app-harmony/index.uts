	public  isEnabled():boolean{
		try {
		  return access.getState()==2;
		} catch (err) {
		  console.error(`checkBluetoothState error: ${JSON.stringify(err)}`);
		  return false;
		}
		 return false;
	 }
	 
	 
	 	public  onStartScanBle(para:ScanPara){
			if(!this.isEnabled()){
				if(para.onScanResult!=null){
					para.onScanResult!(bleResult(10002,"蓝牙未开启",""))
				}
				return
			}
			var that=this;
			that.reqBtPer(function(b:boolean){
				if(b){
					that.onScanBle(para);
				}else{
					if(para.onScanResult!=null){
						para.onScanResult!(bleResult(10001,"",""));
					}
					
				}
			})
		}
	 
	 
	public onScanBle(para:ScanPara ){
		this.scanResultMap.clear();
		if(this.scanBleFunction!=null){
			ble.off("BLEDeviceFind",this.scanBleFunction!)
			this.scanBleFunction=null;
		}
		if(para.showEmptyName==null){
			para.showEmptyName=0;
		}
		
		if(para.btNameFilter==null){
			para.btNameFilter="";
		}
		if(para.fliterNames==null){
			para.fliterNames=[] as string[];
		}
		
		if(this.scanBleFunction==null){
			this.scanBleFunction=(devices:Array<ble.ScanResult>) => {
				// console.log(devices)
			  if (devices && devices.length > 0) {
			    devices.forEach(device => {
					// hmscanMap.set(device.deviceId,device);
					
					if(para.showEmptyName==0){
						
						if(device.deviceName==""){
							return;
						}
						
						if(para.btNameFilter!=""){
							if(!device.deviceName.includes(para.btNameFilter!)){
								return
							}
						}
						
						if(para.fliterNames!.length > 0 ){
							var exist=false;
							for(var i=0;i<para.fliterNames!.length;i++){
								if(device.deviceName.includes(para.fliterNames![i])){
									exist=true;
								}	
							}
							if(!exist){
								return;
							}
						}
						
						
					}
				
					
					
						let per:string|null=null;
						const getPer = (): string => {
							if(per==null){
								per=that.arrayBufferToHexStringWithSpaces(device.data);
							}
							return per!;
						};
						if(!that.scanResultMap.has(device.deviceId)){
							//console.log(device)
							var d:BleScanResult={
							rssi: device.rssi,
							device: {
								name: device.deviceName,
								address: device.deviceId,
								iosLocalName:null,
							} as Device,
							isLegacy: null,
							connectType:null,
							advertisingSid: null,
							dataStatus: null,
							isConnectable: null,
							periodicAdvertisingInterval: null,
							primaryPhy: null,
							secondaryPhy: null,
							timestampNanos: null,
								scanRecord: {
									deviceName: null,
									txPowerLevel: null,
									bytes: getPer(),
									serviceData: null,
									serviceUuids: null,
									advertiseFlags: null,
								manufacturerSpecificData: null,
								serviceSolicitationUuids: null
							} as ScanRecord
						} as BleScanResult
						that.scanResultMap.set(device.deviceId,d);
						if(para.onScanResult!=null){
							para.onScanResult(bleResult(0,"",d))
						}
						
						}
						// console.log(device.deviceName+"  "+that.arrayBufferToHexStringWithSpaces(device.data))
						if(that.scanDataListenerCallback!=null){
							var g={
								mac:device.deviceId,
								rssi:device.rssi,
								data:getPer(),
								name:device.deviceName,
								iosLocalName:null,
								manufacturerData:"",
							} as ScanRssiBR;
						that.scanDataListenerCallback!(bleResult(0,"",g))
						}
				
			    });
			
		}
		}
		}
		ble.on('BLEDeviceFind',this.scanBleFunction!);
		
		let scanFilter: ble.ScanFilter = { 
		};
		
		// 构造扫描配置参数
		let scanOptions: ble.ScanOptions = {
		  interval: 0,
		
		  dutyMode: ble.ScanDuty.SCAN_MODE_LOW_LATENCY,
		  matchMode: ble.MatchMode.MATCH_MODE_STICKY
		}
		var that=this;
		// this.scanResultMap.clear()
		ble.startBLEScan([scanFilter],scanOptions);
		clearTimeout(this.scanTimeout);
		if(para.scantime==null){
			para.scantime=10*1000;
		}
		
		if(para.scantime!=-1){
			this.scanTimeout=	setTimeout(function(){
					that.stopScanBle();
					if(para.scanComplate!=null){
						para.scanComplate!();
					}
					
			},para.scantime)
			
		}
		
		
	}
	
	
	public  setPhy2MMode(){
			
	}
	
	
	public   startScanBleDevice(time:number,callback: (sth:MyApiResult) => void):void{
		if(!this.isEnabled()){
		
			callback(bleResult(10002,"蓝牙未开启",""))
			return
		}
		var that=this;
		that.reqBtPer(function(b:boolean){
			if(b){
				that.scanBle(time,callback);
			}else{
				callback(bleResult(10001,"",""));
			}
		})
	
	}
	public 	stopScanBle():void{
		clearTimeout(this.scanTimeout);
		const hasActiveScanListener=this.scanBleFunction!=null;
		if(this.scanBleFunction!=null){
			try{
				ble.off("BLEDeviceFind",this.scanBleFunction!);
			}catch(err){
				console.log(err);
			}
			this.scanBleFunction=null;
		}
		if(!hasActiveScanListener){
			return;
		}
		try{
			ble.stopBLEScan();
		}catch(err){
			console.log(err)
		}
		
	};
	scanTimeout:number=0;
	public scanBle(time:number,callback: (sth:MyApiResult) => void ){
		this.scanResultMap.clear();
		if(this.scanBleFunction!=null){
			ble.off("BLEDeviceFind",this.scanBleFunction!)
			this.scanBleFunction=null;
		}
		if(this.scanBleFunction==null){
			this.scanBleFunction=(devices:Array<ble.ScanResult>) => {
				// console.log(devices)
			  if (devices && devices.length > 0) {
			    devices.forEach(device => {
					// hmscanMap.set(device.deviceId,device);
						let per:string|null=null;
						const getPer = (): string => {
							if(per==null){
								per=that.arrayBufferToHexStringWithSpaces(device.data);
							}
							return per!;
						};
						if(!that.scanResultMap.has(device.deviceId)){
							//console.log(device)
							var d:BleScanResult={
							rssi: device.rssi,
							device: {
								name: device.deviceName,
								address: device.deviceId,
							} as Device,
							connectType:null,
							isLegacy: null,
							advertisingSid: null,
							dataStatus: null,
							isConnectable: null,
							periodicAdvertisingInterval: null,
							primaryPhy: null,
							secondaryPhy: null,
							timestampNanos: null,
								scanRecord: {
									deviceName: null,
									txPowerLevel: null,
									bytes: getPer(),
									serviceData: null,
									serviceUuids: null,
									advertiseFlags: null,
								manufacturerSpecificData: null,
								serviceSolicitationUuids: null
							} as ScanRecord
						}
						that.scanResultMap.set(device.deviceId,d);
						callback(bleResult(0,"",d))
						}
						// console.log(device.deviceName+"  "+that.arrayBufferToHexStringWithSpaces(device.data))
						if(that.scanDataListenerCallback!=null){
							var g={
								mac:device.deviceId,
								rssi:device.rssi,
								data:getPer(),
								manufacturerData:"",
							} as ScanRssiBR;
						that.scanDataListenerCallback!(bleResult(0,"",g))
						}
				
			    });
			
		}
		}
		}
		ble.on('BLEDeviceFind',this.scanBleFunction!);
		
		let scanFilter: ble.ScanFilter = { 
		};
		
		// 构造扫描配置参数
		let scanOptions: ble.ScanOptions = {
		  interval: 0,
		
		  dutyMode: ble.ScanDuty.SCAN_MODE_LOW_LATENCY,
		  matchMode: ble.MatchMode.MATCH_MODE_STICKY
		}
		var that=this;
		// this.scanResultMap.clear()
		ble.startBLEScan([scanFilter],scanOptions);
		clearTimeout(this.scanTimeout);
		if(time!=-1){
			this.scanTimeout=	setTimeout(function(){
					that.stopScanBle();
			},time)
			
		}
		
	}
	 
	
	public connect(mac:string,auto:boolean,callback: (sth:MyApiResult) => void):void{
		var that=this;
		
		if(!this.isEnabled()){
			callback( bleResult(10002,"蓝牙未开启",that.isEnabled()));
			return;
		}
		
		// try {
		//     // access.addPersistentDeviceId(mac);
		// 	console.log("-- addPersistentDeviceId ",access.getPersistentDeviceIds())
		// } catch (err) {
		//     console.error('errCode: ' + err.code + ', errMessage: ' + err.message);
		// }
		// // console.log("------,"+access.isValidRandomDeviceId("41:42:60:43:99:37"))
		that.reqBtPer(function(b:boolean){
			if(b){
				if(access.isValidRandomDeviceId(mac)){
					that.connectDevices(mac,auto,callback);
				}else{
					callback( bleResult(10005,"蓝牙地址无效",that.isEnabled()));
				}
				
			}else{
				callback( bleResult(10003,"无蓝牙权限",that.isEnabled()));
			}
			
		})
		
		
	
	}
	
	
	connect_timeoutId:number=-1;
	public connectDevices(mac:string,auto:boolean,callback: (sth:MyApiResult) => void):void{
		// console.log("----------1-------")
		
		
		
		if(this.isConnected()){
			callback(bleResult(10004,"bluetooth is connected",""));
			return;
		}
		
		var that=this;
		try {
			that.beginToConnectMac=mac;
				if(this.connectInternal!=0){
					clearInterval(this.connectInternal);
				}
					that.connectMac=mac;

				  that.gattClient = ble.createGattClientDevice(mac);
				  if(that.connectStateFunction!=null){
					  that.gattClient?.off('BLEConnectionStateChange',that.connectStateFunction! );
					  that.connectStateFunction=null;
				}
				  if(that.connectStateFunction==null){
					  that.connectStateFunction=(stateInfo: ble.BLEConnectionChangeState) => {
						 // console.log(stateInfo.state)
						
						
						let state = '';
						// console.log("----------2-------",stateInfo)
						switch (stateInfo.state) {
						  case 0:
						  clearTimeout(that.connect_timeoutId)
							state = 'DISCONNECTED';
							that.isConnecting=false;
							that.connectState=false;
							that.connectCallback(bleResult(10001,"连接断开",1));
							break;
						  case 1:
							state = 'CONNECTING';
							break;
						  case 2:
						  clearTimeout(that.connect_timeoutId)
							if(that.connectState==false){
								state = 'CONNECTED';
								that.connectState=true;
								that.isConnecting=false;
								// console.log("---------6-------")
								that.connectCallback(bleResult(0,"连接成功",0));
							}
							
							break;
						  case 3:
							state = 'DISCONNECTING';
							break;
						  default:
							state = 'undefined';
							break;
						}
					}
				  }
				that.gattClient?.on('BLEConnectionStateChange',that.connectStateFunction! );
				clearTimeout(this.connect_timeoutId)
				// console.log("---------5-------")
			this.connect_timeoutId=	setTimeout(() => {
				  // console.info('do after 1s delay.');
				  that.isConnecting=false;
				  that.gattClient?.off('BLEConnectionStateChange',that.connectStateFunction! );
				  callback({
				  	type:10000,
				  	message:"连接超时",
				  	data:""
				  } as MyApiResult)
				}, that.connect_time_out);
					that.isConnecting=true;
				  that.gattClient?.connect();
				  that.connectCallback=callback
				} catch (err) {
					that.isConnecting=false;
					// console.log(err)
					clearTimeout(this.connect_timeoutId)
					callback(bleResult(10000,"",""))
				 // console.error(`connectDevice error: ${JSON.stringify(err)}`);
				  // return false;
				}
		if(auto){
			that.startAutoConnectBt(that.auto_connect_time,callback)
		}
	}
	
	
	public startAutoConnectBt(time:number,callback: (sth:MyApiResult) => void){
		var that=this;
		if(this.connectInternal!=0){
			clearInterval(this.connectInternal);
		}
		
		this.connectInternal=setInterval(function(){
			if(that.isConnecting){
				return;
			}
			if(!that.isConnected()){
				// console.log("----------3-------")
				
				
				that.connect(that.beginToConnectMac!,false,function(res:MyApiResult){
					// console.log("---------4-------")
					if(res.type==0){
						callback(bleResult(0,"connect success1",1))
					}else if(res.type==10001){
						callback(bleResult(10001,"disconnect",1))
					}
				})
			}
		},time)
	}
	public cancelAutoConnectBt(){
		if(this.connectInternal!=0){
			clearInterval(this.connectInternal);
			this.connectInternal=0;
		}
	}  
	public scanServices(callback:(sth:MyApiResult) => void  ):void{
		try {
			var that=this;
		  // 此处是伪代码，需要连接上后，才可以调用
		  this.gattClient?.getServices().then((result: Array<ble.GattService>) => {
		    // console.info('getServices successfully:' + JSON.stringify(result));
			var bleServices:BleServices[]=[] as BleServices[];
			this.wNList=[] as string[];
			that.scanCharacteristics.clear()
			for(var i=0;i<result.length;i++){
				var ser=result[i];
				var chars:Characteristics[] =[] as Characteristics[];
				var haveW=false;
				var haveN=false;
				var wuuid="";
				var nuuid="";
				for(var j=0;j<ser.characteristics.length;j++){
					var g:ble.GattProperties=ser.characteristics[j].properties!;
					var p:CharacteristicsProperties ={
						WRITE:false,
						READ:false,
						NOTIFY:false,
						INDICATE:false
					} as CharacteristicsProperties;
					if(g.write){
						p.WRITE=true;
						haveW=true;
					}
					if(g.notify){
						p.NOTIFY=true;
						haveN=true;
					}
					if(g.read){
						p.READ=true;
					}
					if(g.writeNoResponse){
						haveW=true;
						p.WRITE=true;
					}
					if(g.indicate){
						p.INDICATE=true;
					}
					
					
					var c={
						uuid:ser.characteristics[j].characteristicUuid,
						properties:p,
						propertiesType:0,
					} as Characteristics;
					if(p.NOTIFY){
						nuuid=c.uuid;
					}
					if(p.WRITE){
						wuuid=c.uuid;
					}
					
					chars.push(c)
					this.scanCharacteristics.set(c.uuid,ser.characteristics[j]);
				}
				
				if(haveN&&haveW){
					this.wNList.push(ser.serviceUuid+"_"+nuuid+"_"+wuuid);
				}
				
				
				bleServices.push({
					uuid:ser.serviceUuid,
					characteristics:chars,
					type:0,
				} as BleServices)
			}
			if(this.wNList.length>0){
					var size=that.wNList.length;
					//console.log(size)
					that.setSelectUUID(size-1);
			}
			callback(bleResult(0,"",bleServices));
		  });
		} catch (err) {
		  // console.error('errCode: ' + (err as BusinessError).code + ', errMessage: ' + (err as BusinessError).message);
		}
		
	} 
	
	
