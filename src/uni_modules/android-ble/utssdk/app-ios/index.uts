		public   isConnected():boolean{
			if(this.curdataCBPeripheral==null){
				return false;
			}
			if(this.curdataCBPeripheral?.state==CBPeripheralState.connected){
				return true;
			}
			return false;
		}
	 
	 
	     public getConnectMac():string{
			if(this.isConnected()){
				return this.beginToConnectMac!;
			}
			
			return "";
			 
			
	     }
		
		public  byte2HexString(data:number[]):string {
			var str="";
				for(var i=0;i<data.length;i++){
					str=str+data[i].toString(16).padStart(2,"0");
					if(i<data.length-1){
						str=str+" ";
					}
				}
				return str.toUpperCase();	
		 }
		
		@UTSJS.keepAlive
		public  writeDataToBle(service:string,chars:string,data:number[],callback:(sth:MyApiResult) => void){
		// 	var c= cbServiceMap.get(service);
		// 	var ch=cBCharacteristicMap.get(chars);
			if(!this.isConnected()){
				callback(bleResult(10005,"bluetooth is not connected",""))
				return
			}
			var str=this.byte2HexString(data);
			this.writeStringDataToBle(service,chars,str,callback)
		
		}
		@UTSJS.keepAlive
	 public  writeStringDataToBle(service:string,chars:string,data:string,callback:(sth:MyApiResult) => void){
		if(!this.isConnected()){
			callback(bleResult(10005,"bluetooth is not connected",""))
			return
		}
		
			var c= cbServiceMap.get(service);
			data=data.split(' ').join('');
			// console.log(data);
			var ch=cBCharacteristicMap.get(chars);
			BluetoothController.shared.sendLargeData(curdataCBPeripheral!,ch!,data,function(res:boolean){
				callback(bleResult(res?0:10001,"success",""))
			})
		
	 }
	 @UTSJS.keepAlive
	 public  writeDataToBleWithType(service:string,chars:string,data:number[],writeType:number,callback:(sth:MyApiResult) => void){
		var str=this.byte2HexString(data);
		 this.writeStringDataToBleWithType(service,chars,str,writeType,callback);
	 }
	 
	 @UTSJS.keepAlive
	 public  writeStringDataToBleWithType(service:string,chars:string,data:string,writeType:number,callback:(sth:MyApiResult) => void){
		 if(!this.isConnected()){
		 	callback(bleResult(10005,"bluetooth is not connected",""))
		 	return
		 }
		 
		 	var c= cbServiceMap.get(service);
		 	data=data.split(' ').join('');
		 	// console.log(data);
		 	var ch=cBCharacteristicMap.get(chars);
		 	BluetoothController.shared.sendLargeDatas(curdataCBPeripheral!,ch!,data,writeType.toInt(),function(res:boolean){
		 		callback(bleResult(res?0:10001,"success",""))
		 	})
	 }
	 
	 
	 
	 @UTSJS.keepAlive
	 public  sendData(data:WriteData,callback:(b:MyApiResult)=>void){
		 if(!this.isConnected()){
			callback(bleResult(10005,"bluetooth is not connected",""))
		 	return
		 }
		 var str="";
		 
		 if(data.hexStrData!=null){
			 str=data.hexStrData!;
			 str=str.split(' ').join('');
		 }
		 if(data.data!=null){
			 str=this.byte2HexString(data.data!);
			 str=str.split(' ').join('');
		 }
			var c= cbServiceMap.get(data.serviceId);
			var ch=cBCharacteristicMap.get(data.characteristicId);
			BluetoothController.shared.setHaveSetMtu(!data.fenbao)
			// console.log(str)
			// data.success!(bleResult(0,"",""))
			if(data.writeType==null){
				// console.log("-----------")
				BluetoothController.shared.sendLargeData(curdataCBPeripheral!,ch!,str,function(res:boolean){
					
					// console.log(res);
					if(res){
						callback(bleResult(0,"发送成功",""))
					}else{
						callback(bleResult(10001,"发送失败",""))
					}
				})
			}else{
				BluetoothController.shared.sendLargeDatas(curdataCBPeripheral!,ch!,str,data.writeType!.toInt(),function(res:boolean){
					if(res){
						callback(bleResult(0,"",""))
					}else{
						callback(bleResult(10001,"",""))
					}
				})
			}
			
			
		 
	 }
	 
	 @UTSJS.keepAlive
	 public onNotityReadBleData(service:string,chars:string,state:boolean,callback:(sth:MyApiResult) => void){
		var that=this;
		var c= cbServiceMap.get(service);
		var ch=cBCharacteristicMap.get(chars);
		if(ch==null){
			callback(bleResult(10001,"notity chars failed",""))
			return
		}
		
		
		BluetoothController.shared.setNotity(curdataCBPeripheral!,ch!,state,function(s:Int,data:string,chars:string,mac:String){
			// console.log(data);
			var st=Number.from(s);
			if(st==3){
				callback(bleResult(0,"read data",that.hexToTypedArray(data)))
			}else if(st==1){
				callback(bleResult(1001,"订阅失败",[] as number[]))
			}else if(st==2){
				callback(bleResult(1000,"订阅成功",[] as number[]))
			}
			
		});
	 }
	 
	 
	 @UTSJS.keepAlive
	 public onNotityBleData(service:string,chars:string,state:boolean,callback:(sth:MyApiResult) => void){
	 		var that=this;
	 		var c= cbServiceMap.get(service);
	 		var ch=cBCharacteristicMap.get(chars);
	 		if(ch==null){
	 			callback(bleResult(10001,"notity chars failed",""))
	 			return
	 		}
	 		
	 		
	 		BluetoothController.shared.setNotity(curdataCBPeripheral!,ch!,state,function(s:Int,data:string,chs:string,mac:String){
	 			// console.log(data);
	 			var st=Number.from(s);
	 			if(st==3){
	 				callback(bleResult(0,"read data",{
						data:that.hexToTypedArray(data),
						serviceId:"",
						characteristicsId:chs,
						mac:mac,
					} as NotityData))
	 			}else if(st==1){
	 				callback(bleResult(1001,"订阅失败",[] as number[]))
	 			}else if(st==2){
	 				callback(bleResult(1000,"订阅成功",[] as number[]))
	 			}
	 			
	 		});
	 }
	 
	  hexToTypedArray(str:string):number[] {
		var b=  str.split(" ");
		var num:number[]= [] as number[];
		for(var i=0;i<b.length;i++){
			 num.push(parseInt(b[i], 16));
		}
		return num;
		
	 }
		 
	 public close():void {
		 this.cancelAutoConnectBt();
		 if(this.curdataCBPeripheral!=null){
			 BluetoothController.shared.disconnect(this.curdataCBPeripheral!)
		 }
	 }
	 
	 @UTSJS.keepAlive
	 readRssi(callback:(b:MyApiResult)=>void){
	 	this.curdataCBPeripheral!.readRSSI();
		BluetoothController.shared.setRssicallback(function(b:string){
			 callback(bleResult(0,"信号",parseInt(b)))
		})
	 }
	 
	@UTSJS.keepAlive
	public setMtu(num:number,callback:(sth:MyApiResult) => void):void{
		haveSetMtu=true;
		BluetoothController.shared.setHaveSetMtu(haveSetMtu)
		callback(bleResult(0,"ios 不支持设置",20))
	 }
	 
	 public string2ByteStrWithCharset(data:string,code:string):string{
	 		if(code=="gbk"||code=="GBK"){
	 				// return data.toGBKHex()!;
	 				
	 				return BluetoothController.shared.toGBKHex(data);
	 			}else if(code=="utf-8"||code=="UTF-8"){
	 				return BluetoothController.shared.utf8toHexString(data);
	 			}
	 			return "";
	 }
	 public byte2StringWithCharset(data:string,code:string):string{
	 		if(code=="gbk"||code=="GBK"){
	 			// return data.utf8hexToString()!;
	 				return BluetoothController.shared.gbkHexToString(data.split(" ").join(""));
	 				
	 		}else if(code=="utf-8"||code=="UTF-8"){
	 			// return data.utf8hexToString()!;
	 				return BluetoothController.shared.utf8hexToString(data.split(" ").join(""));
	 				
	 		}
	 			return ""
	 }
	 
	 public getUUIDs():WNuuid[]{
	 	var ids=[] as WNuuid[];
	 	for(var i=0;i<this.wNList.length;i++){
	 		var b=this.wNList[i].split("_");
	 		ids.push({
	 			serviceId:b[0],
	 			nuuid:b[1],
	 			wuuid:b[2]
	 		} as WNuuid)
	 	}
	 	return ids;
	 }
	 
	 public setSelectUUID(id:number){
		 // console.log("id=",id)
	 	if(id<this.wNList.length){
	 		var b=this.wNList[id].split("_");
	 		this.defaultService=b[0];
	 		this.defaultNotity=b[1];
	 		this.defaultWrite=b[2];
	 	}
	 		
	 }
}
