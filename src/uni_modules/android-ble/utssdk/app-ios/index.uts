	@UTSJS.keepAlive
	public connect(mac:string,auto:boolean,callback: (sth:MyApiResult) => void):void{
			var that=this;
			BluetoothController.checkCentralPermission(function(b:Int){
					var f=Number.from(b);
					if(f==0){
						that.connectToDevice(mac,auto,callback);
					}else{
						callback( bleResult(10003,"无蓝牙权限",that.isEnabled()));						
					}
			});
	}
	
	
	public redictToConnect(mac:string,callback: (sth:MyApiResult) => void){
		var p:CBPeripheral|null=this.connectPb.get(mac);
		var that=this;
		if(p!=null){
			BluetoothController.shared.swToConnect(p!,function(state:boolean,data:CBPeripheral){
				if(state){
					that.curdataCBPeripheral=data;
					that.appbtconnect=true;
					callback(bleResult(0,"connect success",0));
				}else{
					that.appbtconnect=false;
					that.curdataCBPeripheral=null;
					callback(bleResult(10001,"bluetooth disconnect ",0));
				}
				
				
			})
			
		}
		
	}
	
	public getConnectedDevicesWithServices(b:string[]):MyApiResult{
		this.connectPb.clear();
		var c:CBUUID[]=[] as CBUUID[];
		for(var i=0;i<b.length;i++){
			c.push(  BluetoothController.shared.getCBUUID(b[i]))
		}
		var  b:CBPeripheral[] =	BluetoothController.shared.getConnectedDevicesWithServices(c)
		
		var ss:BleScanResult[]=[] as BleScanResult[];
		for(var i=0;i<b.length;i++){
			this.connectPb.set(b[i].identifier.uuidString,b[i]);
			var connect= b[i].state==CoreBluetooth.CBPeripheralState.connected?0:1;
			ss.push({
						device:{
							connectType:connect,
							name:b[i].name,
							address:b[i].identifier.uuidString
						} as Device,
							// connectstate:connect
					} as BleScanResult)
		}
		return bleResult(0,"",ss);
	}
	public retrievePeripherals(b:string[]):MyApiResult{
		// this.connectPb.clear();
		var c:UUID[]=[] as UUID[];
		for(var i=0;i<b.length;i++){
			c.push(  BluetoothController.shared.getUUID(b[i]))
		}
		var  b:CBPeripheral[] =	BluetoothController.shared.retrievePeripherals(c)
		
		var ss:BleScanResult[]=[] as BleScanResult[];
		for(var i=0;i<b.length;i++){
			//this.connectPb.set(b[i].identifier.uuidString,b[i]);
			var connect= b[i].state==CoreBluetooth.CBPeripheralState.connected?0:1;
			ss.push({
						device:{
							connectType:connect,
							name:b[i].name,
							address:b[i].identifier.uuidString
						} as Device,
							// connectstate:connect
					} as BleScanResult)
		}
		return bleResult(0,"",ss);
	}
	
	
	
	
	
	
	
	
	
	
	public connectToDevice(mac:string,auto:boolean,callback: (sth:MyApiResult) => void){
		// if(!this.isEnabled()){
		// 	callback( bleResult(10002,"蓝牙未开启",this.isEnabled()));
		// 	return
		// }
		
		if(this.isConnected()){
			callback(bleResult(10004,"bluetooth is connected",""));
			return;
		}
		this.beginToConnectMac=mac;
		this.connectCallback=callback;
		var that=this;
		if(iosscanMap.has(mac)){
				var p:CBPeripheral=	BluetoothController.shared.getCBPeripheral(mac);
				this. connectTimeout=setTimeout(function(){
					that.isConnecting=false;
					callback(bleResult(10000,"connect timeout",0));
				},that.connect_time_out.toInt());
				that.connectTargetDevice(p,auto,callback);
				
			}else{
				var haveSearch=false;
				this. connectTimeout=setTimeout(function(){
					if(!haveSearch){
						that.stopScanBle();
					}
				that.isConnecting=false;
					callback(bleResult(10000,"connect timeout",0));
				},that.connect_time_out.toInt());
				BluetoothController.shared.startScan(function(res:CBPeripheral,rs:Int, advertisementData:String,maData:String,localName:String){
					iosscanMap.set(res.identifier.uuidString,res);
					if(res.identifier.uuidString == mac){
						haveSearch=true;
						that.stopScanBle();
						var p:CBPeripheral=	BluetoothController.shared.getCBPeripheral(mac);
						that.connectTargetDevice(p,auto,callback);
					}
				});
				
			}
	}
	
	
	public  setPhy2MMode(){
			
	}
	
	
	public connectTargetDevice(p:CBPeripheral,auto:boolean, callback: (sth:MyApiResult) => void){
		var that=this;
		if(auto){
			if(this.isConnecting){
				//callback(bleResult(10004,"current is connecting",""))
				return;
			}
		}
		that.isConnecting=true;
		BluetoothController.shared.connectDevice(p,function(state:boolean,data:CBPeripheral){
			clearTimeout(that.connectTimeout)
			that.isConnecting=false;
			if(state){
				that.curdataCBPeripheral=data;
				that.appbtconnect=true;
				callback(bleResult(0,"connect success",0));
			}else{
				that.appbtconnect=false;
				that.curdataCBPeripheral=null;
				callback(bleResult(10001,"bluetooth disconnect ",0));
			}
			
		})
		if(auto){
			this.startAutoConnectBt(this.auto_connect_time,callback);
		}
	}
	
	
	
	public startAutoConnectBt(time:number,callback: (sth:MyApiResult) => void){
		var that=this;
		if(this.connectInternal!=0){
			clearInterval(this.connectInternal);
		}
		this.connectInternal=setInterval(function(){
			if(that.isConnecting){
				return;
			}
			if(!that.isConnected()){
				// console.log("-------auto connect")
				that.connect(that.beginToConnectMac!,false,function(res:MyApiResult){
					// console.log("auto connect back",res)
					if(res.type==0){
						callback(bleResult(0,"connect success",1))
					}else if(res.type==10001){
						callback(bleResult(10001,"disconnect",1))
					}
				})
			}
		},time.toInt())
	}
	public cancelAutoConnectBt(){
		if(this.connectInternal!=0){
			clearInterval(this.connectInternal);
		}
	}  
	
	@UTSJS.keepAlive
	public scanServices(callback:(sth:MyApiResult) => void  ):void{
		var services:BleServices[]=[] as BleServices[];
			var index=0;
			var that=this;
		BluetoothController.shared.scanServices(that.curdataCBPeripheral!,function(peripheral: CBPeripheral,service: CBService,size:Int){
				 that.curdataCBPeripheral=peripheral;
				var serviceSize=Number.from(size);
				that.wNList=[] as string[];
				var b=service . uuid.uuidString as string;
				var ser={
					type: index++,
					uuid: b,
					characteristics: []  as Characteristics[]
				}  as BleServices;
				services.push(ser)
				cbServiceMap.set(b,service);
				service.characteristics?.forEach(function(value : CBCharacteristic, i : number, array : CBCharacteristic[]){
						var c=value.uuid.uuidString as string;
						cBCharacteristicMap.set(c,value);
						var curCharac={
							uuid:c ,
							propertiesType:0, 
							properties: {
								READ:BluetoothController.getState(0,value.properties),
								WRITE:BluetoothController.getState(1,value.properties)||BluetoothController.getState(4,value.properties),
								NOTIFY:BluetoothController.getState(2,value.properties),
								INDICATE:BluetoothController.getState(3,value.properties),
							} as CharacteristicsProperties
						} as Characteristics;
					 ser.characteristics.push(curCharac);
				})
				
				if(services.length>=serviceSize){
					var havew=false;
					var haveN=false;
					var wuuid="";
					var nuuid="";
					for(var i=0;i<serviceSize;i++){
						for(var j=0;j<services[i].characteristics.length;j++){
							if(services[i].characteristics[j].properties.NOTIFY){
								haveN=true;
								nuuid=services[i].characteristics[j].uuid;
							}
							if(services[i].characteristics[j].properties.WRITE){
								havew=true;
								wuuid=services[i].characteristics[j].uuid;
							}
						}
						if(haveN&&havew){
							that.wNList.push(services[i].uuid+"_"+nuuid+"_"+wuuid)
						}
					}
					
					if(that.wNList.length>0){
							var size=that.wNList.length;
							that.setSelectUUID(Number.from(size)-1);
					}
					callback(bleResult(0,"",services))
				}
			})
	
	
	} 
	
	public getDataMtu(type:number):number{
		
		var b=	BluetoothController.shared.getDataMtu(this.curdataCBPeripheral!,type.toInt());
	
		return Number.from(b)
	}
	
	
	
