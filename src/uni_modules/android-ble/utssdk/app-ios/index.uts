		@UTSJS.keepAlive
		public  onStartScanBle(para:ScanPara){
			var that=this;
			BluetoothController.checkCentralPermission(function(b:Int){
				var s=Number.from(b);
				if(s==0){
					that.onScanBle(para);
				}else{
					if(para.onScanResult!=null){
						para.onScanResult!(bleResult(10001,"无权限",that.isEnabled()))
					}
					
					
				}
				
				
			})
			
		}
		
		@UTSJS.keepAlive
		public onScanBle(para:ScanPara ){
			// if(!this.isEnabled()){
			// 	if(para.onScanResult!=null){
			// 		para.onScanResult!(bleResult(10002,"蓝牙未开启",""))
			// 	}
				
			// 	return
			// }
			if(this.de){
				console.log("开始蓝牙扫描,蓝牙开启状态",this.isEnabled())
			}
			clearTimeout(scanId);
			var that=this;
			if(para.scantime==null){
				para.scantime=10*1000;
			}
			if(para.showEmptyName==null){
				para.showEmptyName=0;
			}
			if(para.btNameFilter==null){
				para.btNameFilter="";
			}
			if(para.fliterNames==null){
				para.fliterNames=[] as string[];
			}
			BluetoothController.shared.setShowEmptyName(para.showEmptyName==0);
			BluetoothController.shared.setFilterBtName(para.btNameFilter!);
			//console.log(para.fliterNames)
			BluetoothController.shared.setfiltersNames(para.fliterNames!);
			if(para.scantime!=-1){
				scanId=setTimeout(function(){
					that.stopScanBle();
					if(para.scanComplate!=null){
						para.scanComplate!()
					}
					
				},para.scantime!.toInt());
			}
			if(this.de){
				console.log("开始蓝牙扫描 步骤1 ",this.isEnabled())
			}
			if(para.iosFilterUUIDs==null){
				para.iosFilterUUIDs=[] as string[];
			}
			var c:CBUUID[]=[] as CBUUID[];
			for(var i=0;i<para.iosFilterUUIDs!.length;i++){
				c.push(  BluetoothController.shared.getCBUUID(para.iosFilterUUIDs![i]))
			}
			BluetoothController.shared.setScanUUIDsFiters(c);
			BluetoothController.shared.startScan(function(res:CBPeripheral,rs:Int, advertisementData:String,maData:String,locname:String){
				if(that.de){
					console.log("扫描蓝牙返回 回掉步骤1  ",res);
				}
				var name:String="";
				if(res.name!=null){
					name = res.name!;
				}
				
				
				if(advertisementData.endsWith(" ")){
					advertisementData=advertisementData.substring(0,advertisementData.length-1);
				}
				if(that.de){
					console.log("扫描蓝牙返回 回掉步骤2  ");
				}
				if(that.scanDataListenerCallback!=null){
					that.scanDataListenerCallback(bleResult(0,"",{
						rssi:Number.from(rs),
						data:advertisementData,
						mac:res.identifier.uuidString,
						manufacturerData:maData,
						name:name,
						iosLocalName:locname,
					} as ScanRssiBR))
				}
				if(that.de){
					console.log("扫描蓝牙返回 回掉步骤3  ");
				}
				// console.log("---------"+name);
				// console.log("---------"+advertisementData+"-");
				if(scanMap.get(res.identifier.uuidString)==null){
					var b={
						rssi:Number.from(rs),
						device:{
							name:name,
							address:res.identifier.uuidString,
							iosLocalName:locname,
						} as Device,
							deviceName:name,
							
						scanRecord:{
							bytes:advertisementData
						}as ScanRecord
						
					} as BleScanResult;
					if(that.de){
						console.log("扫描蓝牙返回 回掉步骤4  ");
					}
					if(para.onScanResult!=null){
						para.onScanResult!(bleResult(0,"ble data ",b))
					}
					if(that.de){
						console.log("扫描蓝牙返回 回掉步骤5  ");
					}
					
				}
				// console.log(res.name,  res.identifier.uuidString)
				scanMap.set(res.identifier.uuidString,res);
				iosscanMap.set(res.identifier.uuidString,res);
				// console.log(b);
			})
			
		}
	
		
	
	
	@UTSJS.keepAlive
	public   startScanBleDevice(time:number,callback: (sth:MyApiResult) => void):void{
			var that=this;
			BluetoothController.checkCentralPermission(function(b:Int){
				var s=Number.from(b);
				if(s==0){
					that.scanBle(time,callback);
				}else{
					callback(bleResult(10001,"无权限",that.isEnabled()))
					
				}
				
				
			})
	
	}
	public 	stopScanBle():void{
			clearTimeout(scanId);
			scanMap.clear();
			BluetoothController.shared.stopScan()
		
		
	};
	@UTSJS.keepAlive
	public scanBle(time:number,callback: (sth:MyApiResult) => void ){
		// if(!this.isEnabled()){
		// 	callback(bleResult(10002,"蓝牙未开启",""))
		// 	return
		// }
		clearTimeout(scanId);
		var that=this;
		scanId=setTimeout(function(){
			that.stopScanBle();
		},time.toInt());
		BluetoothController.shared.startScan(function(res:CBPeripheral,rs:Int, advertisementData:String,maData:String,locaname:string){
			// res.name
			var name:String="";
			if(res.name!=null){
				name = res.name!;
			}
			
			
			if(advertisementData.endsWith(" ")){
				advertisementData=advertisementData.substring(0,advertisementData.length-1);
			}
			if(that.scanDataListenerCallback!=null){
				that.scanDataListenerCallback(bleResult(0,"",{
					rssi:Number.from(rs),
					data:advertisementData,
					mac:res.identifier.uuidString,
					manufacturerData:maData,
					name:name,
					iosLocalName:locaname,
				} as ScanRssiBR))
			}
			
			// console.log("---------"+name);
			// console.log("---------"+advertisementData+"-");
			if(scanMap.get(res.identifier.uuidString)==null){
				var b={
					rssi:Number.from(rs),
					device:{
						name:name,
						address:res.identifier.uuidString,
						iosLocalName:locaname,
					} as Device,
						deviceName:name,
					
						scanRecord:{
						bytes:advertisementData
					}as ScanRecord
					
				} as BleScanResult;
				callback(bleResult(0,"1",b))
				
			}
			// console.log(res.name,  res.identifier.uuidString)
			scanMap.set(res.identifier.uuidString,res);
			iosscanMap.set(res.identifier.uuidString,res);
			// console.log(b);
		})
		
	
	}
	
