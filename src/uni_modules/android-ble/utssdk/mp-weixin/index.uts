	 arrayBufferToHexWithSpaces(buffer) {
	    const bytes = new Uint8Array(buffer);
	    let hexString = '';
	    for (let i = 0; i < bytes.length; i++) {
	        // 将每个字节转换为两位十六进制，并添加空格
	        hexString += bytes[i].toString(16).padStart(2, '0') + ' ';
	    }
	    // 移除末尾可能多余的空格并返回
	    return hexString.trim();
	}
	 hexStringWithSpacesToArrayBuffer(hexString) {
	  // 1. 去除所有空格，并将字符串统一为小写（或大写）以确保一致性
	  const cleanedHex = hexString.replace(/\s/g, '').toLowerCase();
	  
	  // 2. 检查处理后的字符串长度是否为偶数，因为每个字节需要两个16进制字符
	  if (cleanedHex.length % 2 !== 0) {
	    throw new Error('无效的16进制字符串长度。去除空格后长度必须为偶数。');
	  }
	  
	  // 3. 使用正则表达式将字符串分割成两个字符一组的数组
	  const bytePairs = cleanedHex.match(/[0-9a-f]{2}/g);
	  if (!bytePairs) {
	    throw new Error('未找到有效的16进制字节对。');
	  }
	  
	  // 4. 将每个16进制字节对解析为十进制数字（0-255）
	  const byteArray = bytePairs.map(byte => parseInt(byte, 16));
	  
	  // 5. 创建Uint8Array并获取其底层的ArrayBuffer
	  return new Uint8Array(byteArray).buffer;
	}
	constructor(){
		var that=this;
		try{
			wx.openBluetoothAdapter(function(res){
				console.log(res);
				
			});
			wx.onBluetoothAdapterStateChange(function(res){
				if(!res.available){
					if(that.connectCallback!=null){
						that.connectCallback(bleResult(0,"disconnect",0));
					}
				}
				
				
			});
			wx.onBluetoothDeviceFound(function(res){
				// console.log(res);
				var devices=	res.devices;
				
				for(var i=0;i<devices.length;i++){
					if(that.curScanPara!=null){
						if(that.curScanPara?.showEmptyName==0){
							if(res.devices[i].name==undefined||res.devices[i].name==""){
								return
							}
							if(!res.devices[i].name.includes(that.curScanPara!.btNameFilter)){
								return;
							}
							if(that.curScanPara.fliterNames!=undefined){
								if(that.curScanPara.fliterNames.length>0){
									var exist=false;
									for(var i=0;i<that.curScanPara.fliterNames.length;i++){
										if(!res.devices[i].name.includes(that.curScanPara.fliterNames[i])){
											exist=true;
										}
									}
									if(!exist){
										return
									}
								}
								
								
							}
							
							
						}
					}
					
					if(that.scanDataListenerCallback!=null){
						var b:ScanRssiBR={
							mac:devices[i].deviceId,
							name:devices[i].name,
							rssi:devices[i].RSSI,
							data:that.arrayBufferToHexWithSpaces(res.devices[i].advertisData)
						};
						that.scanDataListenerCallback(bleResult(0,"",b))
					}
					
					if(!that.scanResultMap.has(devices[i].deviceId)){
						
						
						var scan:BleScanResult={
							device:{
								name:devices[i].name,
								address:devices[i].deviceId,
							} as Device,
							rssi:devices[i].RSSI,
							scanRecord:{
								bytes:that.arrayBufferToHexWithSpaces(res.devices[i].advertisData)
							} as ScanRecord
						}
						that.scanResultMap.set(devices[i].deviceId,scan)
						that.scanBleDeviceCallback(bleResult(0,"",scan));
					}
				}
				
			})
			
			wx.onBLEConnectionStateChange(function(res){
				console.log(res);
				if(res.deviceId==that.connectMac){
					that.connectState=res.connected;
					if(that.connectCallback!=null){
						that.connectCallback(bleResult(0,"",0));
					}
					
				}
				
			});
		}catch(e){
			
		}
		
		
	}
	
