	public scanServices(callback:(sth:MyApiResult) => void  ):void{
		var that=this;
		wx.getBLEDeviceServices({
			deviceId:this.getConnectMac(),
			success:async function(res){
				console.log(res);
				var services=	res.services;
				var havew=false;
				var wuuid="";
				var haven=false;
				var nuuid="";
				var bleservices:BleServices[]=[] as BleServices[];
				for(var i=0;i<services.length;i++){
					try{
						console.log("-----------------1-------------------------",services[i].uuid)	
						var charsaaa=	await that.scanChars(services[i].uuid,that.getConnectMac());
						var chars=charsaaa.characteristics;
						console.log(chars);
						console.log("-----------------2------------------------",chars.length)
						
						var characteristicsslist:Characteristics[]=[] as Characteristics[];
						
						for(var j=0;j<chars.length;j++){
							var p:CharacteristicsProperties ={
								WRITE:false,
								READ:false,
								NOTIFY:false,
								INDICATE:false
							} as CharacteristicsProperties;
							// p.WRITE=false;
							// p.READ=false;
							// p.NOTIFY=false;
							// p.INDICATE=false;
							if(chars[j].properties.write){
								havew=true;
								p.WRITE=true;
								wuuid=chars[j].uuid;
							}
							if(chars[j].properties.indicate){
								p.INDICATE=true;
							}
							if(chars[j].properties.notify){
								haven=true;
								p.NOTIFY=true;
								nuuid=chars[j].uuid;
							}
							if(chars[j].properties.writeDefault){
								p.WRITE=true;
								wuuid=chars[j].uuid;
							}
							if(chars[j].properties.read){
								p.READ=true;
							}
							if(chars[j].properties.writeNoResponse){
								havew=true;
								p.WRITE=true;
								wuuid=chars[j].uuid;
							}
							
							characteristicsslist.push({
								uuid:chars[j].uuid,
								properties:p,
								propertiesType:0,
							} as Characteristics)
						}
						if(havew&&haven){
							that.wNList.push(services[i].uuid+"_"+nuuid+"_"+wuuid);
							
						}
						
						
						bleservices.push({
							uuid:services[i].uuid,
							type:0,
							characteristics:characteristicsslist
						} as BleServices)
						console.log("----------------",bleservices)
						
						
					}catch(e){
						console.log(e);
					}
				
				}
				if(that.wNList.length>0){
					var  ff=	that.wNList[0].split("_")
					that.tarServiceUUID=ff[0];
					that.wUUID=ff[2];
					that.nUUID=ff[1];
				}
				callback(bleResult(0,"scan service success",bleservices))
				
			}
			
		})
	} 
	
	
	
	public  scanChars(service,deviceid){
		
		return new Promise((ress,rej)=>{
			// setTimeout(()=>{
			// 	 writecmd.setOtaData(deviceId,offset,data).then(success=>{
			// 		 res(success);
			// 	 }).catch(fail=>{
			// 		 rej(fail);
			// 	 });
			// },delTime);	
			
			wx.getBLEDeviceCharacteristics({
				deviceId:deviceid,
				serviceId:service,
				success(res) {
					// res.characteristics[0].properties.
					console.log(res);
					ress(res)
				},
				fail(res) {
					console.log(res);
					rej(res);
				}
			})
		});
		
		
		
	}
	
	
