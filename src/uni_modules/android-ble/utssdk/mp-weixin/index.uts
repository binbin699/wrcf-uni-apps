	public connect(mac:string,auto:boolean,callback: (sth:MyApiResult) => void):void{
		this.connectCallback=callback;
		var that=this;
		wx.createBLEConnection({
			deviceId:mac,
			success(res) {
				if(res.errCode==0){
					that.connectMac=mac;
					that.connectState=true;
					
				};
				console.log(res);
				
			},
			fail:function(res){
				console.log(res);		
				callback(bleResult(10001,"",0))
			}
			
		})
		
	}
	
