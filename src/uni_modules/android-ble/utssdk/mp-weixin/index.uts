	scanTimeout:number=0;
	public   startScanBleDevice(time:number,callback: (sth:MyApiResult) => void):void{
		this.scanBleDeviceCallback=callback;
		var that=this;
		clearTimeout(this.scanTimeout);
		this.scanResultMap.clear();
		this.scanTimeout= setTimeout(function(){
			that.stopScanBle();
		},time);
			wx.startBluetoothDevicesDiscovery({
				allowDuplicatesKey:true,
				success:function(res){
					console.log(res);
				}
			}
			);
	
	}
	
	public  onStartScanBle(para:ScanPara){
		this.curScanPara=para;
		if(!this.isEnabled()){
			if(para.onScanResult!=null){
				para.onScanResult!(bleResult(10002,"蓝牙未开启",""))
			}
			return
		}
		var that=this;
		this.scanBleDeviceCallback=para.onScanResult;
		var that=this;
		clearTimeout(this.scanTimeout);
		this.scanResultMap.clear();
		this.scanTimeout= setTimeout(function(){
			that.stopScanBle();
			para.scanComplate();
			
		},para.scantime);
			wx.startBluetoothDevicesDiscovery({
				allowDuplicatesKey:true,
				success:function(res){
					console.log(res);
				}
			}
			);
	}
	
	public 	stopScanBle():void{
		wx.stopBluetoothDevicesDiscovery();
		
	};
