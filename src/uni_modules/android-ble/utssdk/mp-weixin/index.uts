	     public getConnectMac():string{
			if(this.isConnected()){
				return this.connectMac!;
			}
			 return "";
			
	     }
		
		public  byte2HexString(data:number[]):string {
			var str="";
			for(var i=0;i<data.length;i++){
				str=str+data[i].toString(16).padStart(2,"0")+" ";
			}
			if(str.endsWith(" ")){
				str=str.substring(0,str.length-1);
			}
			return str;
			
		}
		
	
		
		
		public  writeDataToBle(service:string,chars:string,data:number[],callback:(sth:MyApiResult) => void){
				var buffer=new ArrayBuffer(data.length);
				var array=new Uint8Array(buffer);
				for(var i=0;i<data.length;i++){
					array[i]=data[i];
				}
				wx.writeBLECharacteristicValue({
					deviceId:this.getConnectMac(),
					serviceId:service,
					value:buffer,
					characteristicId:chars,
					success(res){
						if(res.errCode==0){
							callback(bleResult(0,"",""));
						
						}else{
							callback(bleResult(10000,"",""));
						}
					},
					fail(res){
						callback(bleResult(10000,"",""));
					}
					
				})
		}
		
	public onNotityReadBleData(service:string,chars:string,state:boolean,callback:(sth:MyApiResult) => void){
		console.log("onNotityReadBleData")
		var that=this;
		wx.onBLECharacteristicValueChange(function(res){
				if(res.deviceId==that.getConnectMac()){
					var data= that.arrayBufferToHexWithSpaces(res.value);
					var d=	data.split(" ");
					var num:number[]=[] as number[];
					for(var i=0;i<d.length;i++){
						num.push(parseInt(d[i],16));
					}
					callback(bleResult(0,"",num));
				}
				
		})
			wx.notifyBLECharacteristicValueChange({
				serviceId:service,
				deviceId:that.getConnectMac(),
				state:state,
				characteristicId:chars,
				success(res){
					console.log(res);
					if(res.errCode==0){
						callback(bleResult(1000,"开启通知成功",num));
					}else{
						callback(bleResult(1001,"开启通知失败",num));
					}
					
					
					
				},fail(res){
					console.log(res)
					callback(bleResult(1001,"开启通知失败",num));
					
				}
				
				
			})
		
	}	
	
	public onNotityBleData(service:string,chars:string,state:boolean,callback:(sth:MyApiResult) => void){
		console.log("onNotityReadBleData")
		var that=this;
		wx.onBLECharacteristicValueChange(function(res){
				
				if(res.deviceId==that.getConnectMac()){
					var data= that.arrayBufferToHexWithSpaces(res.value);
					var d=	data.split(" ");
					var num:number[]=[] as number[];
					for(var i=0;i<d.length;i++){
						num.push(parseInt(d[i],16));
					}
					callback(bleResult(0,"",{
						data:num,
						serviceId:res.serviceId,
						characteristicsId:res.characteristicId,
						mac:res.deviceId,
					} as NotityData));
				}
				
		})
			wx.notifyBLECharacteristicValueChange({
				serviceId:service,
				deviceId:that.getConnectMac(),
				state:state,
				characteristicId:chars,
				success(res){
					console.log(res);
					if(res.errCode==0){
						callback(bleResult(1000,"开启通知成功",num));
					}else{
						callback(bleResult(1001,"开启通知失败",num));
					}
					
					
					
				},fail(res){
					console.log(res)
					callback(bleResult(1001,"开启通知失败",num));
					
				}
				
				
			})
		
	}	
	
	
	
	public  sendData(data:WriteData){
		if(data.fenbao==true){
			callback(bleResult(10006,"微信小程序不支持分包",""));
			return
		}
		
		if(data.data!=null){
			var buffer=new ArrayBuffer(data.data.length);
			var array=new Uint8Array(buffer);
			for(var i=0;i<data.data.length;i++){
				array[i]=data.data[i];
			}
				wx.writeBLECharacteristicValue({
					deviceId:this.getConnectMac(),
					serviceId:data.serviceId,
					value:array,
						
					characteristicId:data.characteristicId,
					success(res){
						if(res.errCode==0){
							callback(bleResult(0,"",""));
						
						}else{
							callback(bleResult(10001,"",""));
						}
					},
					fail(res){
						callback(bleResult(10001,"",""));
					}
					
				})
		}else {
			wx.writeBLECharacteristicValue({
				deviceId:this.getConnectMac(),
				serviceId:data.serviceId,
				value:this.hexStringWithSpacesToArrayBuffer(data.hexStrData),
				characteristicId:data.characteristicId,
				success(res){
					if(res.errCode==0){
						callback(bleResult(0,"",""));
					
					}else{
						callback(bleResult(10001,"",""));
					}
				},
				fail(res){
					callback(bleResult(10001,"",""));
				}
				
			})
			
		}
			 
				 
	}	 
		
	 public  writeStringDataToBle(service:string,chars:string,data:string,callback:(sth:MyApiResult) => void){
		wx.writeBLECharacteristicValue({
			deviceId:this.getConnectMac(),
			serviceId:service,
			value:this.hexStringWithSpacesToArrayBuffer(data),
			characteristicId:chars,
			success(res){
				if(res.errCode==0){
					callback(bleResult(0,"",""));
				
				}else{
					callback(bleResult(10000,"",""));
				}
			},
			fail(res){
				callback(bleResult(10000,"",""));
			}
			
		})
	 }
	 
	 public getUUIDs():WNuuid[]{
	 	var ids=[] as WNuuid[];
	 	for(var i=0;i<this.wNList.length;i++){
	 		var b=this.wNList[i].split("_");
	 		ids.push({
	 			serviceId:b[0],
	 			nuuid:b[1],
	 			wuuid:b[2]
	 		} as WNuuid)
	 	}
	 	return ids;
	 }
	 
	 public setSelectUUID(id:number){
	 	if(id<this.wNList.length){
	 		var b=this.wNList[id].split("_");
	 		this.tarServiceUUID=b[0];
	 		this.nUUID=b[1];
	 		this.wUUID=b[2];
	 	}
	 		
	 }
	 
		 
	 public close():void {
		wx.closeBLEConnection({
			deviceId:this.getConnectMac(),
		})
		 
	 }
	 
	public setMtu(num:number,callback:(sth:MyApiResult) => void):void{
