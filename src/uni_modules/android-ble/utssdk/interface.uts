}

export type BleServices={
	 type:number,
	 uuid: string,
	 characteristics:Characteristics[]
}

export type Characteristics={
	properties:CharacteristicsProperties, 
	 uuid: string,
	 propertiesType: number
}

export type CharacteristicsProperties={
	 READ: boolean,
	 WRITE:boolean,
	 NOTIFY:boolean,
	 INDICATE:boolean
}

export type NotityData={
	data:number[],
	mac?:string,
	serviceId?:string,
	characteristicsId?:string,
}


export  function bleResult(type1 : number, message1 : string,data1 : any):MyApiResult{
	return {
		type : type1,
		message : message1,
		data : data1
	} as MyApiResult
	
}











