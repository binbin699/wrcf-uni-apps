	constructor(){
		super();
		 this.adapter=(UTSAndroid.getAppContext()!.getSystemService(Context.BLUETOOTH_SERVICE) as BluetoothManager).getAdapter();
		 this.btListener();
		
	}
	
	@UTSJS.keepAlive
	public btListener(){
		class MyOnBleCallback implements BleHelper.OnBleCallback{
				lib:BleLib;
				connnetTimerid:number=0;
			constructor(lib:BleLib){
				this.lib=lib;
			}
			override onScanResult(result: ScanResult,json:JSONObject):void{
				var that=this;
				UTSAndroid.getDispatcher(this.lib.threadName).async(function(_){
					try{
						var scan= JSON.parse<BleScanResult>(json.toString());
						if(scan==null){
							return;
						}
						// console.log(scan.device.name,
						// scan.scanRecord.bytes
						// )
						
						if(that.lib.debug){
							console.log("scan= ",scan)
						}
						try{
							that.lib.scanDataListenerCallback(bleResult(0,"",{
								rssi:scan.rssi!,
								mac:result.device.address,
								data:scan.scanRecord!.bytes!,
								manufacturerData:""
							} as ScanRssiBR))
						}catch(e:Exception){
						
						}
						
						if(that.lib.scanResultMap.get(scan.device.address)==null){
							if(that.lib.onBleScanListener!=null){
								if(scan!=null){
									that.lib.onBleScanListener!.onScanCall(bleResult(0,"",scan))
								}
							}
						}
							// scan.device.name=this.scanNameResultMap.get(scan.device.address)
						that.lib.scanResultMap.put(scan.device.address,scan)
					}catch(e:Exception){
						
					}
					
				},null)
				
				
				
			 }
			 
			 
			 
			override   onConnectResult( code: Int, msg: String){
				clearTimeout(this.connnetTimerid);
				var that=this;
				this.connnetTimerid=setTimeout(function(){
					if(that.lib.onBleConnectListener!=null){
						that.lib.onBleConnectListener!.onConnect(bleResult(code,msg,0))
					}
				},600);
				
			}
			 
			 override onBtConnectStateChange(on:boolean){
				 this.lib.btOpenStateCallback(bleResult(0,"",this.lib.isEnabled()))
				 
				 
			 }
			override onServicesDiscovered(gatt: BluetoothGatt, status: Int, json: JSONArray){
				var  bleServices=	JSON.parse<BleServices[]>(json.toString());
				if(bleServices==null){
					bleServices=[];
				}
				 if(this.lib.onBleScanServicesListener!=null){
					 this.lib.onBleScanServicesListener!.onScanService(bleResult(0,"成功扫描到服务",bleServices))
				 }
			}
			 
			override onGattDisconnect(state: Int){
				if(this.lib.onBleConnectListener!=null){
					this.lib.onBleConnectListener!.onConnect(bleResult(1001,"蓝牙异常断开",""))
				}
				
			}
			override onMtuCallBack(status: Int, s: String){
				if(this.lib.onMtuSetListener!=null){
					this.lib.onMtuSetListener!.onMtu(bleResult(parseInt(status+""),s.toString(),""))
				}
			}
			 
			override onWriteState(status: Int, s: String){
				if(this.lib.onBleWriteDataListener!=null){
					this.lib.onBleWriteDataListener!.onWriteData(bleResult(parseInt(status+""),s.toString(),""))
				}
			}
			 
			 
			override onDataRead(value: ByteArray){
				if(this.lib.onBleNotityListener!=null){
						var num:number[]=[];
						 var  d=(value.size).valueOf();	
						 for(var i=0;i<d;i++){
							var data=(value[i.toInt()]).valueOf();
							num.push(data&0xff);
							 
						 }
						this.lib.onBleNotityListener!.onNotityData(bleResult(0,"",num))
				}
			}
			override onDataReads(value: ByteArray,s:String,c:String){
				if(this.lib.onBleNotityListener!=null){
						var num:number[]=[];
						 var  d=(value.size).valueOf();	
						 for(var i=0;i<d;i++){
							var data=(value[i.toInt()]).valueOf();
							num.push(data&0xff);
							 
						 }
						this.lib.onBleNotityListener!.onNotityDatas(bleResult(0,"",{
							 data:num,
							 characteristicsId:c,
							 serviceId:s
						} as NotityData))
				}
			}
			
			override onReadData(state: boolean, value: ByteArray|null){
				if(state){
					if(value!=null){
						var num:number[]=[];
						 var  d=(value.size).valueOf();	
						 for(var i=0;i<d;i++){
							var data=(value[i.toInt()]).valueOf();
							num.push(data&0xff);
						 }
						 this.lib.readDataCallback(bleResult(0,"读取到数据",num))
					}
				}else{
					var num:number[]=[];
					 this.lib.readDataCallback(bleResult(10000,"读取到数据",num))
				}
			}
			
			override onIndicateCallback(state:Int,value: ByteArray|null){
				if(state==0){
					if(value!=null){
						var num:number[]=[];
						var  d=(value.size).valueOf();
						for(var i=0;i<d;i++){
													var data=(value[i.toInt()]).valueOf();
													num.push(data&0xff);
						}
						this.lib.indicateDataCallback(bleResult(Number.from(state),"",num))
					}
					
					
					
				}else{
					var num:number[]=[];
					this.lib.indicateDataCallback(bleResult(Number.from(state),"",num))
					
				}
				
			}
			
			override onReadRssi(int: Int){
				// console.log("onReadRssi ",int)
				this.lib.readrssiCallback(bleResult(0,"rssi",Number.from(int)))
				
			}
			override  onNotityStateCallback(state:Int,msg:String){
				this.lib.onBleNotityListener!.onNotityData(bleResult(Number.from(state),msg,[] as number[]))
				
			}
		}
		 this.bleHelper=new BleHelper(UTSAndroid.getAppContext()!,this.adapter,new MyOnBleCallback(this));
		
	}
	
	
	openBtBluetooth(callback:(b:MyApiResult)=>void){
		
		var that=this;
		if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
			
			if(this.isHavePermision("android.permission.BLUETOOTH_SCAN")||this.isHavePermision("android.permission.BLUETOOTH_CONNECT")){
				that.openBt(callback)
			}else{
				this.requesMoretPermison(["android.permission.BLUETOOTH_SCAN","android.permission.BLUETOOTH_CONNECT"],function(st:boolean){
					if(st){
						that.openBt(callback)
					}else{
						
							callback!( bleResult(10001,"无蓝牙权限",""))
						
					}
				})
			}
		}else{
				if(this.isHavePermision("android.permission.ACCESS_FINE_LOCATION")){
					that.openBt(callback)
				}else{
					this.requestPermison("android.permission.ACCESS_FINE_LOCATION",function(res:boolean){
						if(res){
							that.openBt(callback)
						}else{
								callback!( bleResult(10001,"无蓝牙权限",""))
						}
					})
				}
		}
			
		
		
		
		
		
	}
	
	openBt(callback:(b:MyApiResult)=>void){
		if (!this.isEnabled()) {
		    var enableBtIntent = new Intent(BluetoothAdapter.ACTION_REQUEST_ENABLE);
			UTSAndroid.getUniActivity()!. startActivityForResult(enableBtIntent, 0); 
			UTSAndroid.onAppActivityResult((requestCode: Int, resultCode: Int, data?: Intent) => {
				if(requestCode == 0){
					// 我们发起的请求
					if(resultCode==Activity.RESULT_OK){
						callback(bleResult(0,"",""))
					}else{
						callback(bleResult(1,"",""))
					}
				
				}else{
					// 别的代码发起的请求，不要处理
				}
				UTSAndroid.offAppActivityResult();
			});
		}
	}
	
	
	readRssi(callback:(b:MyApiResult)=>void){
		this.readrssiCallback=callback;
		this.bleHelper!.readRssi();
	}
	
	openBluetooth(on:boolean):void{
		// if(on){
		// 	this.adapter.enable();
		// }else{
		// 	this.adapter.disable();
		// }
		this.bleHelper!.openBle(this.adapter,on);
		
	}
