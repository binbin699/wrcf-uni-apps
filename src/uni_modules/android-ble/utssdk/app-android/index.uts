		public  byte2HexString(data:number[]):string {
			var bytes=new ByteArray(data.length.toInt());
			for(var i =0;i<data.length;i++){
				bytes[i.toInt()]=data[i].toByte();
			}
			return ByteUtil.byte2HexString(bytes);
		}
		
		
		
