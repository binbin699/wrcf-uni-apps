	@UTSJS.keepAlive
	public setMtu(num:number,callback:(sth:MyApiResult) => void):void{
		 class MyOnMtuSetListener implements OnMtuSetListener{
			 override onMtu(res:MyApiResult){
			 					 callback(res)
			 }
			 
		 }
			this.onMtuSetListener=new MyOnMtuSetListener();
			
		var b= this.bleHelper!.requestMtu(num.toInt());
		if(b==false){
			this.onMtuSetListener!.onMtu(bleResult(1,"failed",""))
		}else{
			this.haveSetMtu=true;
		}
		 
		 
	 }
	 
