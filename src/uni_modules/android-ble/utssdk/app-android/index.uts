	@UTSJS.keepAlive
	public onScanDataListener( callback:(res:MyApiResult)=>void){
		// this.scanListenerMac=mac;
		this.scanDataListenerCallback=callback;
		
	}
	
		
	public isHavePermision(pername:string): boolean {
		return	UTSAndroid.checkSystemPermissionGranted(UTSAndroid.getUniActivity()!, [pername])
	 }
	 
	 
	
	 public requestPermison(pername:string, callback: (sth:boolean) => void ) {
		 if(this.isHavePermision(pername)){
			 callback(true);
			 return
		 }
		  UTSAndroid.requestSystemPermission(UTSAndroid.getUniActivity()!, [pername], (_ : boolean, p : string[]) => {
				  callback(true)
		        }, (_ : boolean, p : string[]) => {
		         callback(false)
		        })
		 
		 
		 
	 }
	 
	 public requesMoretPermison(pername:string[], callback: (sth:boolean) => void ) {
			  // 请求拍照权限
				UTSAndroid.requestSystemPermission(UTSAndroid.getUniActivity()!, pername, function (allRight : boolean, _ : string[]) {
					if (allRight) {
						// 权限请求成功
						callback(true);
					} else {
						//用户拒绝了部分权限
						callback(false);
					}
				}, function (_ : boolean, _ : string[]) {
					//用户拒绝了部分权限
					callback(false);
				})
	 		 
	 		 
	 		 
	 }
	public  isEnabled():boolean{
		 return this.adapter.isEnabled();
	 }
	 
	 
	 
	@UTSJS.keepAlive
	public  onStartScanBle(para:ScanPara){
		if(para.scantime==null){
			para.scantime=10*1000;
		}
		var that=this;
		if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
			if(this.isHavePermision("android.permission.BLUETOOTH_SCAN")||this.isHavePermision("android.permission.BLUETOOTH_CONNECT")){
				this.onScanBle(para)
			}else{
				this.requesMoretPermison(["android.permission.BLUETOOTH_SCAN","android.permission.BLUETOOTH_CONNECT"],function(st:boolean){
					if(st){
						that.onScanBle(para)
					}else{
						if(para.onScanResult!=null){
							para.onScanResult!( bleResult(10001,"无蓝牙权限",""))
						}
					}
				})
			}
		}else{
				if(this.isHavePermision("android.permission.ACCESS_FINE_LOCATION")){
					this.onScanBle(para)
				}else{
					this.requestPermison("android.permission.ACCESS_FINE_LOCATION",function(res:boolean){
						if(res){
							that.onScanBle(para)
						}else{
							if(para.onScanResult!=null){
								para.onScanResult!( bleResult(10001,"无蓝牙权限",""))
							}
							
						}
					})
				}
		}
			
			
		
	}
	
	
	@UTSJS.keepAlive
	public onScanBle(para:ScanPara ){
		if(!this.isEnabled()){
			if(para.onScanResult!=null){
				para.onScanResult!(bleResult(10002,"蓝牙未开启",""))
			}
			return
		}
		if(para.showEmptyName==null){
			para.showEmptyName=0;
		}
		
		this.stopScanBle();
		class MyOnBleScanListener implements OnBleScanListener{
		 
				override onScanCall(scan:MyApiResult){
					try{
						if(para.onScanResult!=null){
							para.onScanResult!(scan)
						}
						
					}catch(e:Exception){
					}
				}
		};
		this.onBleScanListener=new MyOnBleScanListener();
	
		if(this.scanTimer!=-1){
			clearTimeout(this.scanTimer)
		}
		this.scanResultMap.clear();
		this.bleHelper!.clearNameMap();
		var that=this;
		
		var settings = new ScanSettings.Builder()
		    .setScanMode(ScanSettings.SCAN_MODE_BALANCED)
		    .build();
		var filters = new ArrayList<ScanFilter>(); 
			this.bleHelper!.setEmptyName(para.showEmptyName==0?true:false)
			if(para.btNameFilter==null){
				para.btNameFilter="";
			}
			this.bleHelper!.setBtFilterName(para.btNameFilter!)
			if(para.fliterNames==null){
				para.fliterNames=[] as string[];
			}
			
			
			if(para.fliterNames!=null){
				var ll:ArrayList<String>=new ArrayList();
				for(var i=0;i<para.fliterNames!.length;i++){
					ll.add(para.fliterNames![i])
				}
				this.bleHelper!.setFilterNameList(ll)
			}
		
			UTSAndroid.getDispatcher("io").async(function(_){
				that.adapter.getBluetoothLeScanner().startScan(filters, settings, that.bleHelper!.leScanCallback);		
			},null)
		
		if(para.scantime!=-1){
			this.scanTimer=	setTimeout(function(){
				
				that.stopScanBle();
				if(para.scanComplate!=null){
					para.scanComplate!();
				}
				
			},para.scantime!)
		}
		
	}
	
	public  setPhy2MMode(){
		if(this.isConnected()){
			this.bleHelper!.setPhy2MMode();
		}
		
	}
	
	
		
	
	
	@UTSJS.keepAlive
	public   startScanBleDevice(time:number,callback: (sth:MyApiResult) => void):void{
		if(time==-1){
			time=Integer.MAX_VALUE;
		}
		var that=this;
		if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
		
			if(this.isHavePermision("android.permission.BLUETOOTH_SCAN")||this.isHavePermision("android.permission.BLUETOOTH_CONNECT")){
				this.scanBle(time,callback)
			}else{
				this.requesMoretPermison(["android.permission.BLUETOOTH_SCAN","android.permission.BLUETOOTH_CONNECT"],function(st:boolean){
					if(st){
						that.scanBle(time,callback)
					}else{
					}
				})
			}
		}else{
				if(this.isHavePermision("android.permission.ACCESS_FINE_LOCATION")){
					this.scanBle(time,callback)
				}else{
					this.requestPermison("android.permission.ACCESS_FINE_LOCATION",function(res:boolean){
						if(res){
							that.scanBle(time,callback)
						}else{
							callback( bleResult(10001,"无蓝牙权限",""))
						}
					})
				}
		}
	
	
	}
	public 	stopScanBle():void{
		this.onBleScanListener=null;
		if(this.scanTimer!=-1){
			clearTimeout(this.scanTimer)
		}
		var that=this;
		if(this.adapter.getBluetoothLeScanner()!=null){
			UTSAndroid.getDispatcher("io").async(function(_){
				that.adapter.getBluetoothLeScanner().stopScan((that.bleHelper!.leScanCallback))
			},null)
		
		}
		
		
	};
	@UTSJS.keepAlive
	public scanBle(time:number,callback: (sth:MyApiResult) => void ){
		
		if(!this.isEnabled()){
			callback(bleResult(10002,"蓝牙未开启",""))
			return
		}
		this.stopScanBle();
		class MyOnBleScanListener implements OnBleScanListener{
		 
				override onScanCall(scan:MyApiResult){
					try{
						callback(scan);
					}catch(e:Exception){
					}
				}
		};
		this.onBleScanListener=new MyOnBleScanListener();
	
		if(this.scanTimer!=-1){
			clearTimeout(this.scanTimer)
		}
		this.scanResultMap.clear();
		this.bleHelper!.clearNameMap();
		var that=this;
		
		var settings = new ScanSettings.Builder()
		    .setScanMode(ScanSettings.SCAN_MODE_BALANCED)
		    .build();
		var filters = new ArrayList<ScanFilter>(); // 可以添加过滤器
		
			UTSAndroid.getDispatcher("io").async(function(_){
				that.adapter.getBluetoothLeScanner().startScan(filters, settings, that.bleHelper!.leScanCallback);		
			},null)
		
		
		// this.adapter.getBluetoothLeScanner().startScan(this.bleHelper!.leScanCallback)
		// this.bleHelper!.startScan();
		this.scanTimer=	setTimeout(function(){
			that.stopScanBle();
		},time)
	}
	
	@UTSJS.keepAlive
	public connect(mac:string,auto:boolean,callback: (sth:MyApiResult) => void):void{
		var that=this;
		if(!this.isEnabled()){
			callback(bleResult(10002,"蓝牙未开启",""));
			return;
		}
		this.beginToConnectMac=mac;
		if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
			if(this.isHavePermision("android.permission.ACCESS_FINE_LOCATION")&&this.isHavePermision("android.permission.BLUETOOTH_SCAN")||this.isHavePermision("android.permission.BLUETOOTH_CONNECT")){
				that.connectDevices(mac,auto,callback);
			}else{
				this.requesMoretPermison(["android.permission.ACCESS_FINE_LOCATION","android.permission.BLUETOOTH_SCAN","android.permission.BLUETOOTH_CONNECT"],function(st:boolean){
					if(st){
						that.connectDevices(mac,auto,callback);
					}else{
						callback( bleResult(10003,"无蓝牙权限",that.isEnabled()));
					}
				})
			}
		}else{
				if(this.isHavePermision("android.permission.ACCESS_FINE_LOCATION")){
						
					that.connectDevices(mac,auto,callback);
				}else{
					this.requestPermison("android.permission.ACCESS_FINE_LOCATION",function(res:boolean){
						if(res){
							that.connectDevices(mac,auto,callback);
						}else{
							callback( bleResult(10003,"无蓝牙权限",that.isEnabled()));						}
					})
				}
		}
		
		
		
		
	
	}
	
	connect_timeoutId:number=-1;
	
	
	@UTSJS.keepAlive
	public connectDevices(mac:string,auto:boolean,callback: (sth:MyApiResult) => void):void{
		
		
		
		if(this.isConnected()){
			callback(bleResult(10004,"bluetooth is connected",""));
			return;
		}
		
		var that=this;
		class MyOnBleConnectListener implements OnBleConnectListener{
		 
				override onConnect(res:MyApiResult){
					clearTimeout(that.connect_timeoutId);
					that.isConnecting=false;
					callback(res)
				}
		};
		
		this.onBleConnectListener=new MyOnBleConnectListener();
		this.connectCallback=callback;
		
		if(this.connect_timeoutId!=-1){
			clearTimeout(this.connect_timeoutId);
		}
		
		this.connect_timeoutId=setTimeout(function(){
			that.isConnecting=false;
			that.bleHelper!.removeConnectCallback(mac);
			callback({
				type:10000,
				message:"connect timeout",
				data:""
			} as MyApiResult)
		},this.connect_time_out.toInt());
		
		that.isConnecting=true;
		if(UTSAndroid.getAppContext()!=null){
			UTSAndroid.getDispatcher("io").async(function(_){
			that.bleHelper!.connect(UTSAndroid.getAppContext()!,mac,auto)
		},null)
			
		}
		if(auto){
			this.startAutoConnectBt(this.auto_connect_time,callback);
		}
		
	}
	
	
	public startAutoConnectBt(time:number,callback: (sth:MyApiResult) => void){
		var that=this;
		if(this.connectInternal!=0){
			clearInterval(this.connectInternal);
		}
		this.connectInternal=setInterval(function(){
			if(that.isConnecting){
				return
			}
			if(!that.isConnected()){
				that.connect(that.beginToConnectMac!,false,function(res:MyApiResult){
					if(res.type==0){
						callback(bleResult(0,"connect success",1))
					}else if(res.type==10001){
						callback(bleResult(10001,"disconnect",1))
					}
				})
			}
		},time.toInt())
	}
	
	
	
	
	
	public cancelAutoConnectBt(){
		if(this.connectInternal!=0){
			clearInterval(this.connectInternal);
		}
	}  
	@UTSJS.keepAlive
	public scanServices(callback:(sth:MyApiResult) => void  ):void{
		var that=this;
		 class MyOnBleScanServicesListener implements OnBleScanServicesListener{
			 override onScanService(res:MyApiResult){
				 var services:BleServices[]=res.data as BleServices[];
				  that.wNList=[] as string[];
				 for(var i=0;i<services.length;i++){
					 var haveW=false;
					 var haveN=false;
					 var nid="";
					 var wid="";
					 // that.tarServiceUUID="";
					 for(var j=0;j<services[i].characteristics.length;j++){
						 if(services[i].characteristics[j].properties.NOTIFY){
							 haveN=true;
							 nid=services[i].characteristics[j].uuid
						 }
						 if(services[i].characteristics[j].properties.WRITE){
						 	 haveW=true;
							 wid=services[i].characteristics[j].uuid
						 }
						 
						 
					 }
					 if(haveW&&haveN){
						 that.wNList.push(services[i].uuid+"_"+nid+"_"+wid)
					 	
					 }
				
				 }
				 if(that.wNList.length>0){
					var size=that.wNList.length;
					that.setSelectUUID(Number.from(size)-1);
				 }
				 callback(res)
			 }
		 }
	    this.onBleScanServicesListener=new MyOnBleScanServicesListener();
		UTSAndroid.getDispatcher("io").async(function(_){
						that.bleHelper!.readServices();
		},null)
		
	} 
	
	
	public getUUIDs():WNuuid[]{
		var ids=[] as WNuuid[];
		for(var i=0;i<this.wNList.length;i++){
			var b=this.wNList[i].split("_");
			ids.push({
				serviceId:b[0],
				nuuid:b[1],
				wuuid:b[2]
			} as WNuuid)
		}
		return ids;
	}
	
	public setSelectUUID(id:number){
		if(id<this.wNList.length){
			var b=this.wNList[id].split("_");
			this.tarServiceUUID=b[0];
			this.nUUID=b[1];
			this.wUUID=b[2];
		}
			
	}
	
	
	
	
