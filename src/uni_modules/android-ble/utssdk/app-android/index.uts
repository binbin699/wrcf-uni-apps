	 @UTSJS.keepAlive
	 public  sendData(data:WriteData,callback:(b:MyApiResult)=>void){
		 
		 var that=this;
		 var haveErr=false;
		 var writeDelayId=-1;
		 // console.log(ByteUtil.byte2HexString(bytes))
		 class MyOnBleWriteDataListener implements OnBleWriteDataListener{
		 	override	onWriteData(res:MyApiResult){
				
				if(res.type!=0){
					haveErr=true;
				}
				if(data.fenbao){
					clearTimeout(writeDelayId)
					writeDelayId=setTimeout(function(){
						if(haveErr){
							callback(bleResult(10001,"分包过程有写入失败",""))
						}else{
							callback(bleResult(0,"分包写入成功",""))
						}
				},100)
					
				}else{
					callback(res);
				}
				
				
		 		 
		 	}
		 }
		 var bytes:ByteArray|null=null;
		 if(data.data!=null){
			  bytes=new ByteArray(data.data!.length.toInt());
			 var that=this;
			 for(var i =0;i<data.data.length;i++){
			 	bytes[i.toInt()]=data.data[i].toByte();
			 }
		 }
		if(data.hexStrData!=null){
			bytes=ByteUtil.parseHexStr2Byte(data.hexStrData!)
		}
		 this.onBleWriteDataListener=new MyOnBleWriteDataListener();
		 UTSAndroid.getDispatcher("io").async(function(_){
			 if(data.writeType==null){
				that.bleHelper!.sendData(data.serviceId,data.characteristicId,bytes!,data.fenbao);
			 }else{
				that.bleHelper!.sendDataNew(data.serviceId,data.characteristicId,bytes!,data.fenbao,data.writeType.toInt());
			 }
			 
		 },null)
		 
		 
	 }
	 
	 
	 
	 
