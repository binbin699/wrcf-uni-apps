# 需要补充 .env文件作为公共env
# .env.development 作为测试环境env
# .env.production  作为生产环境env


# 控制应用版本，可选值：full, cn, intl，详情见 @/configs/index.ts
VITE_APP_EDITION=full

# 覆盖后端 API 基础地址（可选，留空则使用版本默认值）
# VITE_BASE_URL=http://47.112.207.28:8001

# 蓝牙配网是否启用设备名称筛选，可选值：true, false，默认 true
VITE_BLE_FILTER_ENABLED=true

# 用户协议和隐私政策 URL（必填）
VITE_TERMS_URL=https://www.qiniu.com/agreements/user-agreement
VITE_PRIVACY_URL=https://www.qiniu.com/agreements/privacy-right

# 控制首页设置引导的显示
# 可选值: qrcode, bluetooth, both (不填默认为 both)
VITE_APP_SETUP_MODE=both

# 是否支持声纹
VITE_APP_USE_VOICEPRINT=true
