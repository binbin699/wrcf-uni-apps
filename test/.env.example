# Android device id from `adb devices`.
DEVICE_ID=YOUR_ANDROID_DEVICE_ID

# HBuilderX debug-base package on the test device.
APP_PACKAGE=io.dcloud.HBuilder

# E2E account. Keep real credentials in test/.env.
TEST_EMAIL=your-test-account@example.com
TEST_PASSWORD=your-test-password

# Stable visible test data used by Maestro assertions.
TEST_USER_NAME="Your Test User Name"
TEST_DEVICE_NAME_REGEX=Device-.*

# Fixture availability flags.
# Leave these as 0 when the account has no managed test fixture.
HAS_TEST_DEVICE=0
HAS_TEST_AGENT=0

# When 1, blocked flows make the runner exit non-zero.
BLOCKED_IS_FAILURE=0

# Optional runner settings.
REPORT_ROOT=test/reports
FLOW_TARGETS="test/flows/smoke test/flows/device test/flows/agent test/flows/profile"
